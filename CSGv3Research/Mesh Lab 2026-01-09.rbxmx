								<ProtectedString name="Source"><![CDATA[--CLAUDE MADE THIS 
-- Simple LZ4 Decompressor for LuaU
local function decompressLZ4(compressedData, uncompressedSize)
	local inputSize = buffer.len(compressedData)
	local output = buffer.create(uncompressedSize)

	local inputPos = 0
	local outputPos = 0

	while inputPos < inputSize and outputPos < uncompressedSize do
		-- Read token
		local token = buffer.readu8(compressedData, inputPos)
		inputPos = inputPos + 1

		-- Extract literal length from upper 4 bits
		local literalLength = bit32.rshift(token, 4)

		-- Handle extended literal length
		if literalLength == 15 then
			while inputPos < inputSize do
				local byte = buffer.readu8(compressedData, inputPos)
				inputPos = inputPos + 1
				literalLength = literalLength + byte
				if byte ~= 255 then break end
			end
		end

		-- Copy literals
		if literalLength > 0 then
			buffer.copy(output, outputPos, compressedData, inputPos, literalLength)
			inputPos = inputPos + literalLength
			outputPos = outputPos + literalLength
		end

		-- Check if we've reached the end
		if inputPos >= inputSize then break end

		-- Read match offset
		local matchOffset = buffer.readu16(compressedData, inputPos)
		inputPos = inputPos + 2

		-- Extract match length from lower 4 bits
		local matchLength = bit32.band(token, 15) + 4

		-- Handle extended match length
		if bit32.band(token, 15) == 15 then
			while inputPos < inputSize do
				local byte = buffer.readu8(compressedData, inputPos)
				inputPos = inputPos + 1
				matchLength = matchLength + byte
				if byte ~= 255 then break end
			end
		end

		-- Copy match (handles overlapping matches)
		local matchStart = outputPos - matchOffset
		for i = 0, matchLength - 1 do
			local byte = buffer.readu8(output, matchStart + i)
			buffer.writeu8(output, outputPos + i, byte)
		end
		outputPos = outputPos + matchLength
	end

	return output
end

return decompressLZ4]]></ProtectedString>
