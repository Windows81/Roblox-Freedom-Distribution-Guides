						<string name="ScriptGuid">{538A4AC7-E18A-416B-BE78-9308B8AD2B14}</string>
						<ProtectedString name="Source"><![CDATA[--!native
local CollisionData = {}
local HttpService = game:GetService("HttpService")
local DEBUG = false;

function CollisionData:GetHeader(collisionBuffer: buffer)
	local targetBuffer = buffer.create(51);
	buffer.copy(targetBuffer, 0, collisionBuffer, 0, 51)
	return targetBuffer
end

function CollisionData:Decode(collisionBuffer: buffer, mesh: MeshPart)
	local offset = 6; -- SKIPS THE CSGPHS HEADER
	local bufferLen = buffer.len(collisionBuffer);

	local function readu32()
		local int = buffer.readu32(collisionBuffer, offset);
		offset += 4;
		return int
	end

	local function readf32()
		local float = buffer.readf32(collisionBuffer, offset)
		offset += 4;
		return float;
	end

	local function readVector3()
		return vector.create(readf32(), readf32(), readf32())
	end

	local function readPhysicsData()
		local volume = readf32()
		local gravityCenter = readVector3()
		local im_xx, im_xy, im_xz, im_yy, im_yz, im_zz = readf32(), readf32(), readf32(), readf32(), readf32(), readf32();

		if DEBUG then
			print(`\n-=====[ PHYSICS DATA ]=====-\nVolume: {volume}\nCenter of gravity: {gravityCenter}\n-==========================-\n`)
		end

		return {
			volume = volume,
			gravityCenter = gravityCenter,
			inertia = {im_xx, im_xy, im_xz, im_yy, im_yz, im_zz}
		}
	end

	local totalFaceCount = 0

	local function readMesh()
		offset += 40 -- trash bytes
		local vertexAmount = readu32() / 3;
		local vertices = {};

		local vertWidth = readu32();

		for i = 1, vertexAmount do
			table.insert(vertices, readVector3() / mesh.MeshSize)
		end

		local faceCount = readu32() / 3;
		local faces = {}

		for i = 1, faceCount do
			table.insert(faces, {readu32() + 1, readu32() + 1, readu32() + 1})
		end

		totalFaceCount += faceCount;

		return {Vertices = vertices, Triangles = faces, vertWidth = vertWidth};
	end


	local collisionType = readu32();
	local hulls = {};
	local physicsData = nil;

	if collisionType == 7 then
		offset += 1
		physicsData = readPhysicsData()

		while offset + 1 < bufferLen do
			table.insert(hulls, readMesh())
		end
	end

	if DEBUG then
		print(`\n-=====[ COLLISION DATA ]=====-\nHulls: {#hulls}\nTriangles: {totalFaceCount}\n-============================-\n`)
	end

	return hulls, physicsData, collisionType
end

function CollisionData:Encode(hulls, physicsData, mesh: MeshPart, collisionType: number?)
	collisionType = collisionType or 7

	-- Calculate buffer size needed
	local bufferSize = 6 -- CSGPHS header
	bufferSize += 4 -- collision type

	if collisionType == 7 then
		bufferSize += 1 -- extra byte after collision type
		bufferSize += 4 + 12 + 24 -- physics data (volume + gravity center + inertia matrix)

		for _, hull in pairs(hulls) do
			bufferSize += 40 -- trash bytes
			bufferSize += 4 -- vertex count
			bufferSize += 4 -- vertex width
			bufferSize += #hull.Vertices * 12 -- vertices (3 floats each)
			bufferSize += 4 -- face count
			bufferSize += #hull.Triangles * 12 -- faces (3 u32s each)
		end
	end

	local collisionBuffer = buffer.create(bufferSize)
	local offset = 0

	local function writeu32(value)
		buffer.writeu32(collisionBuffer, offset, value)
		offset += 4
	end

	local function writef32(value)
		buffer.writef32(collisionBuffer, offset, value)
		offset += 4
	end
	
	local function writeu8(value)
		buffer.writeu8(collisionBuffer, offset, value)
		offset += 1
	end

	local function writeVector3(vec)
		writef32(vec.x)
		writef32(vec.y)
		writef32(vec.z)
	end

	local function writetrash()
		writeu32(16)

		for i = 1, 16 do writeu8(0) end

		writeu32(16)

		for i = 1, 14 do writeu8(0) end

		writeu8(0x80)
		writeu8(0x3F)
	end

	-- Write CSGPHS header
	buffer.writestring(collisionBuffer, 0, "CSGPHS")
	offset = 6

	-- Write collision type
	writeu32(collisionType)

	if collisionType == 7 then
		-- This byte indicates the property 2 --> Default, 3 --> Precicse
		buffer.writeu8(collisionBuffer, offset, 3)
		offset += 1

		-- Write physics data
		if physicsData then
			writef32(physicsData.volume)
			writeVector3(physicsData.gravityCenter)
			for i = 1, 6 do
				writef32(physicsData.inertia[i])
			end
		else
			-- Default physics data
			writef32(1.0) -- volume
			writeVector3(vector.create(0, 0, 0)) -- gravity center
			writef32(1.0) -- im_xx
			writef32(0.0) -- im_xy
			writef32(0.0) -- im_xz
			writef32(1.0) -- im_yy
			writef32(0.0) -- im_yz
			writef32(1.0) -- im_zz
		end

		-- Write mesh data
		for _, hull in pairs(hulls) do
			-- Write 40 trash bytes
			writetrash()

			-- Write vertex count (multiplied by 3)
			writeu32(#hull.Vertices * 3)

			-- Write vertex width
			writeu32(4)

			-- Write vertices (already in collision space, don't scale)
			for _, vertex in pairs(hull.Vertices) do
				writeVector3(vertex)
			end

			-- Write face count (multiplied by 3)
			writeu32(#hull.Triangles * 3)

			-- Write faces (subtract 1 from indices)
			for _, face in pairs(hull.Triangles) do
				writeu32(face[1] - 1)
				writeu32(face[2] - 1)
				writeu32(face[3] - 1)
			end
		end
	end

	if DEBUG then
		print(`\n-=====[ ENCODED COLLISION DATA ]=====-\nBuffer size: {bufferSize}\nHulls: {#hulls}\n-====================================-\n`)
	end

	return collisionBuffer
end

return CollisionData]]></ProtectedString>
