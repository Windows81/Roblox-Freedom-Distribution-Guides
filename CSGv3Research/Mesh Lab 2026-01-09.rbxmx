						<string name="ScriptGuid">{697FBBF1-6260-45C9-8BD8-54523FBA976D}</string>
						<ProtectedString name="Source"><![CDATA[local AssetService = game:GetService("AssetService")

local MeshConverter = {}

function MeshConverter:GetBlockGeometry(size: Vector3)
	local hx, hy, hz = size.X/2, size.Y/2, size.Z/2

	local vertices = {
		Vector3.new(-hx, -hy, -hz),
		Vector3.new(hx, -hy, -hz),
		Vector3.new(hx, hy, -hz),
		Vector3.new(-hx, hy, -hz),
		Vector3.new(-hx, -hy, hz),
		Vector3.new(hx, -hy, hz),
		Vector3.new(hx, hy, hz),
		Vector3.new(-hx, hy, hz),
	}

	local triangles = {
		{1,3,2},{1,4,3},
		{5,7,8},{5,6,7},
		{1,2,6},{1,6,5},
		{4,7,3},{4,8,7},
		{1,5,8},{1,8,4},
		{2,3,7},{2,7,6},
	}

	return vertices, triangles
end

function MeshConverter:GetWedgeGeometry(size: Vector3)
	local hx, hy, hz = size.X/2, size.Y/2, size.Z/2

	local vertices = {
		Vector3.new(hx, -hy, -hz),
		Vector3.new(-hx, -hy, -hz),
		Vector3.new(-hx, -hy, hz), 
		Vector3.new(hx, -hy, hz),  
		Vector3.new(hx, hy, hz),
		Vector3.new(-hx, hy, hz),  
	}

	local triangles = {
		{1,3,2}, {1,4,3},
		{1,6,5}, {1,2,6},
		{4,5,6}, {4,6,3},
		{1,5,4}, {2,3,6},
	}

	return vertices, triangles
end

function MeshConverter:GetSphereGeometry(radius: number)
	local vertices, triangles = {}, {}
	local midpointCache = {}

	local t = (1 + math.sqrt(5)) / 2
	local scale = radius / math.sqrt(1 + t * t)

	local function addVertex(x, y, z)
		table.insert(vertices, Vector3.new(x * scale, y * scale, z * scale))
		return #vertices
	end

	addVertex(-1, t, 0)
	addVertex(1, t, 0)
	addVertex(-1, -t, 0)
	addVertex(1, -t, 0)

	addVertex(0, -1, t)
	addVertex(0, 1, t)
	addVertex(0, -1, -t)
	addVertex(0, 1, -t)

	addVertex(t, 0, -1)
	addVertex(t, 0, 1)
	addVertex(-t, 0, -1)
	addVertex(-t, 0, 1)

	local faces = {
		{1, 12, 6}, {1, 6, 2}, {1, 2, 8}, {1, 8, 11}, {1, 11, 12},
		{2, 6, 10}, {6, 12, 5}, {12, 11, 3}, {11, 8, 7}, {8, 2, 9},
		{4, 10, 5}, {4, 5, 3}, {4, 3, 7}, {4, 7, 9}, {4, 9, 10},
		{5, 10, 6}, {3, 5, 12}, {7, 3, 11}, {9, 7, 8}, {10, 9, 2}
	}

	local function getMidpoint(v1, v2)
		local key = math.min(v1, v2) .. "_" .. math.max(v1, v2)
		if midpointCache[key] then
			return midpointCache[key]
		end

		local p1 = vertices[v1]
		local p2 = vertices[v2]
		local mid = (p1 + p2) / 2

		local normalized = mid.Unit * radius
		table.insert(vertices, normalized)

		midpointCache[key] = #vertices
		return #vertices
	end

	for _ = 1, 2 do
		local newFaces = {}
		for _, face in faces do
			local v1, v2, v3 = face[1], face[2], face[3]

			local a = getMidpoint(v1, v2)
			local b = getMidpoint(v2, v3)
			local c = getMidpoint(v3, v1)

			table.insert(newFaces, {v1, a, c})
			table.insert(newFaces, {v2, b, a})
			table.insert(newFaces, {v3, c, b})
			table.insert(newFaces, {a, b, c})
		end
		faces = newFaces
		midpointCache = {}
	end

	triangles = faces

	return vertices, triangles
end

function MeshConverter:GetCylinderGeometry(size: Vector3, segments: number, orientation: CFrame)
	orientation = orientation or CFrame.new()
	segments = math.max(3, math.floor(segments or 24))

	local length = size.X   
	local radius = math.min(size.Y, size.Z) / 2    

	local vertices, triangles = {}, {}

	for i = 0, segments - 1 do
		local theta = 2 * math.pi * i / segments
		local c, s = math.cos(theta), math.sin(theta)

		local pos = Vector3.new( length/2, radius * c, radius * s)
		local neg = Vector3.new(-length/2, radius * c, radius * s)

		table.insert(vertices, orientation:PointToWorldSpace(pos))
		table.insert(vertices, orientation:PointToWorldSpace(neg))
	end

	for i = 0, segments - 1 do
		local pos0, neg0 = i*2 + 1, i*2 + 2
		local pos1, neg1 = ((i+1)%segments)*2 + 1, ((i+1)%segments)*2 + 2

		table.insert(triangles, {pos0, pos1, neg0})
		table.insert(triangles, {neg0, pos1, neg1})
	end

	local centerPos = #vertices + 1
	local centerNeg = #vertices + 2
	table.insert(vertices, orientation:PointToWorldSpace(Vector3.new( length/2, 0, 0)))
	table.insert(vertices, orientation:PointToWorldSpace(Vector3.new(-length/2, 0, 0)))

	for i = 0, segments - 1 do
		local pos0, pos1 = i*2 + 1, ((i+1)%segments)*2 + 1
		local neg0, neg1 = pos0 + 1, pos1 + 1

		table.insert(triangles, {pos0, centerPos, pos1})
		table.insert(triangles, {neg1, centerNeg, neg0})
	end

	return vertices, triangles
end

local function getPartGeometry(part: BasePart)
	if part.Shape == Enum.PartType.Block then
		return MeshConverter:GetBlockGeometry(part.Size)
	elseif part.Shape == Enum.PartType.Wedge then
		return MeshConverter:GetWedgeGeometry(part.Size)
	elseif part.Shape == Enum.PartType.Cylinder then
		return MeshConverter:GetCylinderGeometry(part.Size, 16)
	elseif part.Shape == Enum.PartType.CornerWedge then
		--return MeshConverter:GetCornerWedgeGeometry(part.Size)
	elseif part.Shape == Enum.PartType.Ball then
		return MeshConverter:GetSphereGeometry(part.ExtentsSize.X/2, 16, 16)
	else
		return {}, {}
	end
end

local function transformVertex(part: BasePart, v: Vector3)
	return part.CFrame:PointToWorldSpace(v)
end

function MeshConverter:GetPartGeometry(part: BasePart)
	return getPartGeometry(part);
end

function MeshConverter:ModelToEditableMesh(model: Model): EditableMesh
	local editableMesh = AssetService:CreateEditableMesh()

	for _, part in model:QueryDescendants('BasePart:not(MeshPart,UnionOperation)') do
		local vertices, triangles = getPartGeometry(part)
		local vertexIds = {}
		for i, v in vertices do
			vertexIds[i] = editableMesh:AddVertex(transformVertex(part, v))
		end
		for _, tri in triangles do
			editableMesh:AddTriangle(vertexIds[tri[1]], vertexIds[tri[2]], vertexIds[tri[3]])
		end
	end
	
	return editableMesh
end

function MeshConverter:ModelToMeshPart(model: Model): MeshPart
	local editableMesh = MeshConverter:ModelToEditableMesh(model);
	
	return AssetService:CreateMeshPartAsync(Content.fromObject(editableMesh));
end

return MeshConverter]]></ProtectedString>
