					<string name="Name">ScalingController</string>
					<string name="ScriptGuid">{AE38A268-98F8-42F3-889B-80E1D13B8344}</string>
					<ProtectedString name="Source"><![CDATA[local ScalingController = {
	Guis = {};	
};
local camera = workspace.CurrentCamera;

ScalingController.CurrentScale = 1;

function ScalingController:UpdateScale()
	local guis = ScalingController.Guis;
	
	for _, gui in guis do 
		for _, scales: UIScale in gui:GetDescendants() do
			if not scales:IsA"UIScale" then continue end;
			if scales:GetAttribute("ManualScale") then continue end;
			if scales:FindFirstAncestorOfClass("Configuration") then continue end;
			
			local multiplier = scales:GetAttribute("Multiplier") or 1
			
			scales.Scale = self:GetScale() * multiplier;
		end
	end
end

function ScalingController:GetScale()
	local viewportSizeX = workspace.CurrentCamera.ViewportSize.X;
	local scale = viewportSizeX / 1920;
	self.CurrentScale = scale;

	return scale;
end;

function ScalingController:Initialize(gui)
	if table.find(self.Guis, gui) then return end;
	
	table.insert(self.Guis, gui);
	task.spawn(function()
		self:UpdateScale();
	end)
end

camera:GetPropertyChangedSignal('ViewportSize'):Connect(function() ScalingController:UpdateScale() end);

return ScalingController;]]></ProtectedString>
					<int64 name="SourceAssetId">-1</int64>
