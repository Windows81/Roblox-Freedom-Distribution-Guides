				<Item class="ModuleScript" referent="RBX0DA5AC2CA1094F90992C3F1EDDE21E93">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">SaveHulls</string>
						<string name="ScriptGuid">{CD7C1F58-5279-4A8D-9017-4B491E8E297D}</string>
						<ProtectedString name="Source"><![CDATA[local SerializationService = game:GetService("SerializationService");
local Selection = game:GetService("Selection");
local EncodingService = game:GetService("EncodingService")

local module = {
	Icon = "rbxassetid://120643548451843",
	Name = "Save Collision Geometry",
	LayoutOrder = 3,
	Category = "Collision"
}

local modules = script.Parent.Parent.Modules;

local rbxmParse = require(modules.rbxmParse);
local CollisionData = require(modules.CollisionData);
local PartsToMesh = require(modules.PartsToMesh)
local CSGPHS8 = require(script.CSGPHS8)


local function convertParent(obj: MeshPart | UnionOperation, inst: Instance)
	if inst.Parent == obj then
		return 'Parent'
	else
		return inst.Parent;
	end
end

local function preserveJoints(obj: MeshPart | UnionOperation)
	local originalData = {} :: {[JointInstance]: {}};
	local preservedHierarchy = {};

	for _, v in obj:GetChildren() do
		table.insert(preservedHierarchy, {v, convertParent(obj, v)});
	end

	for _, joint: Constraint | JointInstance in obj:GetJoints() do --Prevent the joints from the parent being broken/breaking
		if joint:IsA('JointInstance') or joint:IsA('WeldConstraint') then
			local foundPart = joint.Part0 == obj and 'Part0' or 'Part1';

			originalData[joint] = {
				['Original'] = foundPart	
			}
		end
	end

	for _, v in preservedHierarchy do
		v[1].Parent = nil;
	end

	return preservedHierarchy, originalData;
end

local function loadHierarchy(newObj: Instance, preservedHierarchy: {{any}}, jointData: {[JointInstance]: {['Original']: 'Part0' | 'Part1'}})
	for _,v in preservedHierarchy do
		v[1].Parent = v[2] == 'Parent' and newObj or v[2];
	end

	for joint, v in jointData do
		joint[v.Original] = newObj;
	end
end

local function bufhex(buf)
	local len = buffer.len(buf)
	local parts = table.create(len)
	for i = 0, len - 1 do
		table.insert(parts, string.format("%02X", buffer.readu8(buf, i)))
	end
	return table.concat(parts, " ")
end

local function getuncomp(data)
	if buffer.len(data) < 16 then return data end

	local magic = buffer.readu32(data, 12)
	if magic == 0xFD2FB528 then
		local fileHeader = buffer.create(12)
		buffer.copy(fileHeader, 0, data, 0, 12)

		local compSize = buffer.len(data) - 12
		local compBuf = buffer.create(compSize)
		buffer.copy(compBuf, 0, data, 12, compSize)

		local decompressed = EncodingService:DecompressBuffer(compBuf, Enum.CompressionAlgorithm.Zstd)

		local full = buffer.create(12 + buffer.len(decompressed))
		buffer.copy(full, 0, fileHeader, 0, 12)
		buffer.copy(full, 12, decompressed, 0, buffer.len(decompressed))
		return full
	end

	return data
end

local function safeDivVector3(num: Vector3, den: Vector3)
	return Vector3.new(
		if math.abs(den.X) > 1e-6 then num.X / den.X else 0,
		if math.abs(den.Y) > 1e-6 then num.Y / den.Y else 0,
		if math.abs(den.Z) > 1e-6 then num.Z / den.Z else 0
	)
end


function module:Run()
	local obj: MeshPart | UnionOperation = game:GetService("Selection"):Get()[1]
	if not obj then 
		warn("No object selected")
		return 
	end

	local decomposedMesh: Model = 	obj:FindFirstChild("DecomposedMesh") or -- SELECTING ROOT MESH
		(obj.Name == "DecomposedMesh" and obj) or  -- SELECTING DECOMPOSED MESH 
		(obj.Parent.Name == "DecomposedMesh" and obj.Parent) -- SELECTING MESH DIRECTLY

	if not decomposedMesh then 
		warn("No DecomposedMesh found")
		return 
	end

	obj = decomposedMesh.Parent;
	local meshCFrame = obj.CFrame
	local targetMeshSize = obj.Size
	local targetImportSize = obj.MeshSize
	local hulls = {}

	-- Convert decomposed children to collision data format
	for _, child in decomposedMesh:GetDescendants() do
		local vertices, triangles = {}, {}
		local isRaw = child:GetAttribute("IsRaw")
		local isValidHull = false

		if child:IsA("Folder") then
			if child:GetAttribute("ZeroFaces") or isRaw then
				isValidHull = true
				if isRaw == nil then isRaw = true end
				-- Empty geometry
			end

		elseif child:IsA("MeshPart") then
			isValidHull = true
			local remap = {}
			local hullEditableMesh: EditableMesh = child.MeshContent.Object
			local meshSize = child:GetAttribute("OriginalSize") or hullEditableMesh:GetSize()

			local scale = safeDivVector3(child.Size, meshSize)

			local hullCFrame = child.CFrame

			for idx, vertexId in hullEditableMesh:GetVertices() do
				remap[vertexId] = idx
				local vertPosition = meshCFrame:PointToObjectSpace(
					hullCFrame:PointToWorldSpace(hullEditableMesh:GetPosition(vertexId) * scale)
				)

				local norm = safeDivVector3(vertPosition, targetMeshSize)
				local collisionSpaceVert = norm * targetImportSize

				table.insert(vertices, {collisionSpaceVert.X, collisionSpaceVert.Y, collisionSpaceVert.Z})
			end

			for _, faceId in hullEditableMesh:GetFaces() do
				local faceVertices = hullEditableMesh:GetFaceVertices(faceId)
				table.insert(triangles, {remap[faceVertices[1]] - 1, remap[faceVertices[2]] - 1, remap[faceVertices[3]] - 1})
			end

		elseif child:IsA("BasePart") then
			isValidHull = true
			local rawVerts, rawTris = PartsToMesh:GetPartGeometry(child)
			local hullCFrame = child.CFrame

			for id, vert in rawVerts do
				local vertPosition = meshCFrame:PointToObjectSpace(hullCFrame:PointToWorldSpace(vert))
				local norm = safeDivVector3(vertPosition, targetMeshSize)
				local collisionSpaceVert = norm * targetImportSize
				vertices[id] = {collisionSpaceVert.X, collisionSpaceVert.Y, collisionSpaceVert.Z}
			end

			for _, tri in rawTris do
				table.insert(triangles, {tri[1] - 1, tri[2] - 1, tri[3] - 1})
			end
		end

		if isValidHull then
			table.insert(hulls, {
				Vertices = vertices, 
				Triangles = triangles,
				IsRaw = isRaw
			})
		end
	end

	decomposedMesh:Destroy()

	-- Get original collision data
	local preserved, jointData = preserveJoints(obj);
	local rbxmBuffer = SerializationService:SerializeInstancesAsync({obj});
	local sstrChunk = rbxmParse.GetSSTR(rbxmBuffer, obj);
	local sharedStrings = sstrChunk.SharedStrings;

	local collisionIndex = nil
	for i, s in sharedStrings do
		if s.str:sub(1,6) ~= "CSGPHS" then continue; end
		collisionIndex = i;
		break;
	end

	if not collisionIndex then
		warn("Collision data not found in shared strings")
		return
	end

	local collisionBuffer = buffer.fromstring(sharedStrings[collisionIndex].str)
	local uncompressedOriginal = getuncomp(collisionBuffer)
	--print(`ORIGINAL UNCOMPRESSED ({buffer.len(uncompressedOriginal)}b):`)
	--print(bufhex(uncompressedOriginal))

	-- Decode original collision data to get physics data and collision type
	local originalHulls, originalPhysics, collisionType = CollisionData:Decode(collisionBuffer, obj);

	-- Re-encode with new hull data
	local newCollisionBuffer, debugBuffer = CSGPHS8.Encode(hulls);

	--print(`NEW UNCOMPRESSED ({buffer.len(debugBuffer)}b):`)
	--print(bufhex(debugBuffer))

	-- Update shared string with new collision data
	sharedStrings[collisionIndex].str = buffer.tostring(newCollisionBuffer);

	-- Save and deserialize
	local newRbxmBuffer = rbxmParse.SaveSSTR(rbxmBuffer, sstrChunk)
	local deserializedObjects = SerializationService:DeserializeInstancesAsync(newRbxmBuffer)

	--print("COLLISION DATA EQUAL?", buffer.tostring(debugBuffer)==buffer.tostring(uncompressedOriginal))
	--print("COMPRESSED DATA EQUAL?", buffer.tostring(newCollisionBuffer)==buffer.tostring(collisionBuffer))
	
	--workspace.WriteData.BinDiffOut.Source = `ORIGINAL:\n{bufhex(uncompressedOriginal)}\n\nNEW:\n{bufhex(debugBuffer)}\n`
	
	warn("[MESH LAB] Successfully processed collision data!")

	if deserializedObjects and #deserializedObjects > 0 then
		deserializedObjects[1].Parent = obj.Parent;
		deserializedObjects[1].CFrame = obj.CFrame;

		loadHierarchy(deserializedObjects[1], preserved, jointData);
		Selection:Set({deserializedObjects[1]});
		obj:Destroy();
	end
end

return module]]></ProtectedString>
						<int64 name="SourceAssetId">-1</int64>
						<BinaryString name="Tags"></BinaryString>
					</Properties>
					<Item class="ModuleScript" referent="RBXD5B2D5CC6B164052B39D352999755BB3">
						<Properties>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">CSGPHS8</string>
							<string name="ScriptGuid">{DB15603B-DCF2-4C82-A819-08588D1B8BFE}</string>
							<ProtectedString name="Source"><![CDATA[--[[ WRITTEN BY CLV ]]

local EncodingService = game:GetService("EncodingService")

local function createBitStream()
	return { bits = {} }
end

local function bitStreamWriteBit(stream, bit)
	table.insert(stream.bits, if bit == 1 or bit == true then 1 else 0)
end

local function bitStreamWriteBits(stream, val, count)
	for i = count - 1, 0, -1 do
		bitStreamWriteBit(stream, bit32.band(bit32.rshift(val, i), 1))
	end
end

local function bitStreamPack(stream)
	local words = {}
	local bit_idx = 1
	local total_bits = #stream.bits

	while bit_idx <= total_bits do
		local remaining = total_bits - bit_idx + 1
		local val = 0
		local width = 0

		if remaining >= 32 then
			width = 32
			for i = 0, 31 do
				local b = stream.bits[bit_idx + i]
				val = bit32.bor(val, bit32.lshift(b, 31 - i))
			end
			bit_idx += 32
		else
			width = remaining
			for i = 0, width - 1 do
				local b = stream.bits[bit_idx + i]
				val = bit32.bor(val, bit32.lshift(b, width - 1 - i))
			end
			bit_idx += width
		end
		table.insert(words, val)
	end

	local buf = buffer.create(#words * 4)
	for i, w in words do
		buffer.writeu32(buf, (i - 1) * 4, w)
	end

	return buf, total_bits
end

local function encodeRawHulls(hulls)
	if #hulls == 0 then return buffer.create(0), 0 end

	local hull_ranges = {}
	local index_base = {}
	local vertex_ranges = {}
	local component_data = {}

	local idx_cursor = 0
	local comp_cursor = 0

	for i, h in hulls do
		local flat_indices = {}
		for _, tri in h.Triangles do
			table.insert(flat_indices, tri[1])
			table.insert(flat_indices, tri[2])
			table.insert(flat_indices, tri[3])
		end

		for _, idx in flat_indices do table.insert(index_base, idx) end
		idx_cursor += #flat_indices
		table.insert(hull_ranges, idx_cursor)

		local flat_verts = {}
		for _, v in h.Vertices do
			table.insert(flat_verts, v[1])
			table.insert(flat_verts, v[2])
			table.insert(flat_verts, v[3])
		end

		for _, comp in flat_verts do table.insert(component_data, comp) end
		comp_cursor += #flat_verts
		table.insert(vertex_ranges, comp_cursor)
	end

	local function to_u32_buf(t)
		local b = buffer.create(#t * 4)
		for i, v in t do buffer.writeu32(b, (i-1)*4, v) end
		return b
	end

	local parts = {}

	local b_c1 = buffer.create(4); buffer.writeu32(b_c1, 0, #hull_ranges)
	table.insert(parts, b_c1)
	table.insert(parts, to_u32_buf(hull_ranges))

	if #index_base > 0 then
		table.insert(parts, to_u32_buf(index_base))
	end

	local current_len = 0
	for _, p in parts do current_len += buffer.len(p) end
	local pad = current_len % 4
	if pad ~= 0 then
		table.insert(parts, buffer.create(4 - pad))
	end

	local b_c2 = buffer.create(4); buffer.writeu32(b_c2, 0, #vertex_ranges)
	table.insert(parts, b_c2)
	table.insert(parts, to_u32_buf(vertex_ranges))

	if #component_data > 0 then
		local b_comp = buffer.create(#component_data * 4)
		for i, v in component_data do buffer.writef32(b_comp, (i-1)*4, v) end
		table.insert(parts, b_comp)
	end

	local total_size = 0
	for _, p in parts do total_size += buffer.len(p) end

	local final = buffer.create(total_size)
	local offset = 0
	for _, p in parts do
		buffer.copy(final, offset, p, 0, buffer.len(p))
		offset += buffer.len(p)
	end

	return final, total_size
end

local function encodeSingleHull(hull, bs, global_verts_out)
	local faces = hull.Triangles
	local original_verts = hull.Vertices
	if #faces == 0 then return end

	local v_map = {} 
	local ordered_verts = {} 

	local function map_vert(orig_idx)
		if v_map[orig_idx] == nil then
			v_map[orig_idx] = #ordered_verts 
			table.insert(ordered_verts, original_verts[orig_idx + 1]) 
		end
		return v_map[orig_idx]
	end

	local f0_idx = 1
	local f0 = nil
	for i, tri in faces do
		if tri[1] ~= tri[2] and tri[1] ~= tri[3] and tri[2] ~= tri[3] then
			f0 = tri
			f0_idx = i
			break
		end
	end

	if not f0 then return end

	map_vert(f0[1]); map_vert(f0[2]); map_vert(f0[3])

	local adj = {}
	local function add_adj(u, v, f_idx)
		local key = u .. "_" .. v
		if not adj[key] then adj[key] = {} end
		table.insert(adj[key], f_idx)
	end

	for i, tri in faces do
		local f_idx = i - 1 
		add_adj(tri[1], tri[2], f_idx)
		add_adj(tri[2], tri[3], f_idx)
		add_adj(tri[3], tri[1], f_idx)
	end

	local visited_faces = {[f0_idx - 1] = true}

	local function makeNode(val) return {val = val, prev = nil, next = nil} end

	local n0, n1, n2 = makeNode(0), makeNode(1), makeNode(2)
	n0.next = n1; n0.prev = n2
	n1.next = n2; n1.prev = n0
	n2.next = n0; n2.prev = n1

	local boundary_map = {[0] = n0, [1] = n1, [2] = n2}

	local dec_to_orig = {}
	for k, v in v_map do dec_to_orig[v] = k end

	local function get_neighbor_face(u_d, v_d)
		local u_o, v_o = dec_to_orig[u_d], dec_to_orig[v_d]
		if u_o == nil or v_o == nil then return nil end

		local key = v_o .. "_" .. u_o 
		local candidates = adj[key]
		if not candidates then return nil end

		for _, f_idx in candidates do
			if not visited_faces[f_idx] then return f_idx end
		end
		return nil
	end

	local function get_third_vert(f_idx, u_d, v_d)
		local u_o, v_o = dec_to_orig[u_d], dec_to_orig[v_d]
		local tri = faces[f_idx + 1] 
		for _, x in tri do
			if x ~= u_o and x ~= v_o then return x end
		end
		return nil
	end

	local recursive_encode
	recursive_encode = function(u_node, v_node)
		while true do
			local u_dec, v_dec = u_node.val, v_node.val
			local f_next = get_neighbor_face(u_dec, v_dec)

			if f_next == nil then
				bitStreamWriteBits(bs, 7, 3) 
				return
			end

			local w_orig = get_third_vert(f_next, u_dec, v_dec)

			if w_orig == nil then
				bitStreamWriteBits(bs, 7, 3)
				return
			end

			visited_faces[f_next] = true

			if v_map[w_orig] == nil then 
				bitStreamWriteBit(bs, 0)

				local w_dec = #ordered_verts
				v_map[w_orig] = w_dec
				dec_to_orig[w_dec] = w_orig
				table.insert(ordered_verts, original_verts[w_orig + 1])

				local w_node = makeNode(w_dec)
				w_node.prev = u_node
				w_node.next = v_node

				u_node.next = w_node
				v_node.prev = w_node
				boundary_map[w_dec] = w_node

				v_node = w_node
			else
				local w_dec = v_map[w_orig]

				if boundary_map[w_dec] == nil then
					bitStreamWriteBits(bs, 7, 3) 
					return
				end

				local w_node = boundary_map[w_dec]

				if w_node == v_node.next and w_node == u_node.prev then
					bitStreamWriteBits(bs, 7, 3) 
					boundary_map[u_dec] = nil; boundary_map[v_dec] = nil; boundary_map[w_dec] = nil
					return
				elseif w_node == v_node.next then 
					bitStreamWriteBits(bs, 6, 3)
					u_node.next = w_node
					w_node.prev = u_node
					boundary_map[v_dec] = nil
					v_node = w_node
				elseif w_node == u_node.prev then 
					bitStreamWriteBits(bs, 5, 3)
					w_node.next = v_node
					v_node.prev = w_node
					boundary_map[u_dec] = nil
					u_node = w_node
				else 
					local f_right = get_neighbor_face(u_dec, w_dec)
					local f_left = get_neighbor_face(w_dec, v_dec)
					local right_closed = (f_right == nil)
					local left_closed = (f_left == nil)

					if right_closed then 
						bitStreamWriteBits(bs, 5, 3)
						w_node.next = v_node
						v_node.prev = w_node
						boundary_map[u_dec] = nil
						u_node = w_node
					elseif left_closed then 
						bitStreamWriteBits(bs, 6, 3)
						u_node.next = w_node
						w_node.prev = u_node
						boundary_map[v_dec] = nil
						v_node = w_node
					else
						bitStreamWriteBits(bs, 4, 3)

						local w_node_right = makeNode(w_dec)
						w_node_right.next = w_node.next
						w_node_right.next.prev = w_node_right
						w_node_right.prev = u_node

						u_node.next = w_node_right

						w_node.next = v_node
						v_node.prev = w_node

						local old_w_node_map = boundary_map[w_dec]
						boundary_map[w_dec] = w_node_right

						recursive_encode(u_node, w_node_right)

						boundary_map[w_dec] = old_w_node_map
						u_node = w_node
					end
				end
			end
		end
	end

	recursive_encode(n2, n0)

	for _, v in ordered_verts do table.insert(global_verts_out, v) end
end

local function encodeClersHulls(hulls)
	local bs = createBitStream()
	local all_verts = {}

	for _, h in hulls do
		encodeSingleHull(h, bs, all_verts)
	end

	local vert_bytes = buffer.create(#all_verts * 12)
	for i, v in all_verts do
		local off = (i-1) * 12
		buffer.writef32(vert_bytes, off, v[1])
		buffer.writef32(vert_bytes, off + 4, v[2])
		buffer.writef32(vert_bytes, off + 8, v[3])
	end

	local bits_buf, bit_count = bitStreamPack(bs)
	return bits_buf, bit_count, vert_bytes
end

local CSGPHS8 = {}

function CSGPHS8.Encode(hulls)
	local raw_hulls = {}
	local clers_hulls = {}

	for _, hull in hulls do
		local isRaw = hull.IsRaw

		if isRaw then
			table.insert(raw_hulls, hull)
		else
			table.insert(clers_hulls, hull)
		end
	end
	
	--print(`encoding {#raw_hulls} raw and {#clers_hulls} clers`)
	local d1_buf, d1_size = encodeRawHulls(raw_hulls)
	local d3_buf, d2_bit_count, d4_buf = encodeClersHulls(clers_hulls)
	local d3_size = buffer.len(d3_buf)
	local d4_size = buffer.len(d4_buf)

	local total_verts = 0
	local total_faces = 0

	for _, h in clers_hulls do 
		total_verts += #h.Vertices 
		total_faces += #h.Triangles
	end

	for _, h in raw_hulls do 
		total_verts += #h.Vertices 
	end

	local fh_v, fh_f = 0, 0
	local function scan_max(list)
		for _, h in list do
			if #h.Vertices > fh_v then fh_v = #h.Vertices end
			if #h.Triangles > fh_f then fh_f = #h.Triangles end
		end
	end
	scan_max(clers_hulls)
	scan_max(raw_hulls)

	local min_v = {math.huge, math.huge, math.huge}
	local max_v = {-math.huge, -math.huge, -math.huge}

	local function scan_bounds(list)
		for _, h in list do
			for _, v in h.Vertices do
				for k=1,3 do
					if v[k] < min_v[k] then min_v[k] = v[k] end
					if v[k] > max_v[k] then max_v[k] = v[k] end
				end
			end
		end
	end
	scan_bounds(clers_hulls)
	scan_bounds(raw_hulls)

	if total_verts == 0 then 
		min_v = {0,0,0}; max_v = {0,0,0} 
	end

	local header = buffer.create(60) 
	local o = 0
	local function w32(x) buffer.writeu32(header, o, x); o+=4 end
	local function wf(x) buffer.writef32(header, o, x); o+=4 end

	w32(#clers_hulls)
	w32(d4_size // 12)
	w32(total_faces)
	w32(fh_v)
	w32(fh_f)
	w32(d1_size)
	w32(d2_bit_count)
	w32(d3_size)
	w32(d4_size)
	wf(min_v[1]); wf(min_v[2]); wf(min_v[3])
	wf(max_v[1]); wf(max_v[2]); wf(max_v[3])

	local payload_len = 60 + d1_size + d3_size + d4_size
	local payload = buffer.create(payload_len)
	buffer.copy(payload, 0, header, 0, 60)

	local c = 60
	if d1_size > 0 then buffer.copy(payload, c, d1_buf, 0, d1_size); c += d1_size end
	if d3_size > 0 then buffer.copy(payload, c, d3_buf, 0, d3_size); c += d3_size end
	if d4_size > 0 then buffer.copy(payload, c, d4_buf, 0, d4_size); c += d4_size end

	local geomType = 3

	local debug_file = buffer.create(12 + payload_len)
	buffer.writestring(debug_file, 0, "CSGPHS")
	buffer.writeu32(debug_file, 6, 8) 
	buffer.writeu8(debug_file, 10, geomType)
	buffer.writeu8(debug_file, 11, 0)
	buffer.copy(debug_file, 12, payload, 0, payload_len)

	local compressed = EncodingService:CompressBuffer(payload, Enum.CompressionAlgorithm.Zstd)

	local final_file = buffer.create(12 + buffer.len(compressed))
	buffer.writestring(final_file, 0, "CSGPHS")
	buffer.writeu32(final_file, 6, 8) 
	buffer.writeu8(final_file, 10, geomType)
	buffer.writeu8(final_file, 11, 0)
	buffer.copy(final_file, 12, compressed, 0, buffer.len(compressed))

	return final_file, debug_file
end

return CSGPHS8]]></ProtectedString>
