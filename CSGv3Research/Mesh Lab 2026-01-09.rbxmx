						<string name="ScriptGuid">{687C78D1-04C5-4F07-AFF8-F9C1CE05B84E}</string>
						<ProtectedString name="Source"><![CDATA[local Selection = game:GetService("Selection");

local module = {
	Icon = "rbxassetid://111557428820480",
	Name = "Edit Mesh Vertices",
	LayoutOrder = 5,
	Category = "Mesh"
}

local function isConvex(editableMesh: EditableMesh)
	local center = editableMesh:GetCenter();

	local nonConvex, wrongDot;
	local minPenetration = math.huge

	for _, vertexId in editableMesh:GetVertices() do

		local relativePoint = editableMesh:GetPosition(vertexId);
		local localPoint = (relativePoint - center)

		for _, faceId in editableMesh:GetFaces() do
			local vertices = editableMesh:GetFaceVertices(faceId);
			local a, b, c = editableMesh:GetPosition(vertices[1]), editableMesh:GetPosition(vertices[2]), editableMesh:GetPosition(vertices[3])
			if a == relativePoint or b == relativePoint or c == relativePoint then continue end

			local faceCenter = (a+b+c) / 3;

			local normal = vector.normalize(vector.cross(b - a, c - a)) -- SHOUTOUT CLV FOR NUCLEAR QUANTUM FORMULA  
			local distance = vector.dot(normal, a) -- SHOUTOUT CLV FOR NUCLEAR QUANTUM FORMULA   
			if distance < 0 then -- SHOUTOUT CLV FOR NUCLEAR QUANTUM FORMULA   
				normal = -normal -- SHOUTOUT CLV FOR NUCLEAR QUANTUM FORMULA   
				distance = -distance -- SHOUTOUT CLV FOR NUCLEAR QUANTUM FORMULA   
			end -- SHOUTOUT CLV FOR NUCLEAR QUANTUM FORMULA   

			local pointUnit = (faceCenter - relativePoint).Unit;
			local dotProduct = pointUnit:Dot(normal);

			if dotProduct > -0.1 then
				continue
			else
				wrongDot = dotProduct
				nonConvex = true
				break
			end
		end	
		if nonConvex then break end;
	end

	return not nonConvex, wrongDot
end

function module:Run(promptLibrary)
	local selectedMesh = Selection:Get()[1] :: MeshPart;
	if not (selectedMesh and selectedMesh:IsA'MeshPart') then warn('[MESH LAB] Please select a MeshPart') return end;

	local content = selectedMesh.MeshContent;
	if content.SourceType ~= Enum.ContentSourceType.Object then warn('[MESH LAB] MeshPart must be editable') return end;
	local editableMesh = selectedMesh.MeshContent.Object;

	local prompt = promptLibrary();

	local originalMeshSize = editableMesh:GetSize();
	local scaling = selectedMesh.Size / originalMeshSize;

	local reusedPositions = {};
	local originalPositions = {};
	
	local startConvexOnly = selectedMesh:FindFirstAncestor("DecomposedMesh") and true;
	
	local convexToggle = prompt:AddToggle("Convex Only", startConvexOnly)

	for _, faceId in editableMesh:GetFaces() do
		local vertices = editableMesh:GetFaceVertices(faceId);
		for _, vertexId in vertices do
			local vertPosition = editableMesh:GetPosition(vertexId);
			originalPositions[vertexId] = vertPosition;


			local reusedPosition = reusedPositions[vertPosition]
			if reusedPosition then 
				local samePosVert = Instance.new('Folder');
				samePosVert.Name = vertexId;
				samePosVert.Parent = reusedPosition 	
			else
				local attachment = Instance.new('Attachment');
				attachment.Name = vertexId;
				attachment.Visible = true

				reusedPositions[vertPosition] = attachment;

				vertPosition *= scaling;
				attachment.Position = vertPosition;
				attachment.Parent = selectedMesh;
			end;
		end
	end

	local liveUpdateLoop = true;
	task.spawn(function()
		while task.wait() do
			if not liveUpdateLoop then break end;

			local oldVerts = {};

			local selectedAttachments = Selection:Get();
			for i, vertexAttachmentSet in selectedAttachments do
				if vertexAttachmentSet.Parent == selectedMesh then
					local lastChange = vertexAttachmentSet:GetAttribute("LastChange")
					if lastChange and lastChange == vertexAttachmentSet.Position then
						continue;
					end

					local attachmentPos = vertexAttachmentSet.Position
					local unscaledVertPos = attachmentPos / scaling;
					local setId = tonumber(vertexAttachmentSet.Name);
					oldVerts[vertexAttachmentSet] = editableMesh:GetPosition(setId);

					for _, vertexAttachment in {vertexAttachmentSet, unpack(vertexAttachmentSet:GetChildren())} do
						local vertId = tonumber(vertexAttachment.Name);
						editableMesh:SetPosition(vertId, unscaledVertPos);
					end;

					vertexAttachmentSet:SetAttribute("LastChange", attachmentPos);
				else
					table.remove(selectedAttachments, i);
					Selection:Set(selectedAttachments);
				end
			end

			if convexToggle() then
				local convex, wrongDot = isConvex(editableMesh);
				if not convex then
					--warn(`NON CONVEX MESH ({wrongDot}), REVERTED TO LAST POSITIONS`);
					for vertexAttachmentSet, vertPos in oldVerts do
						for _, vertexAttachment in {vertexAttachmentSet, unpack(vertexAttachmentSet:GetChildren())} do
							local vertId = tonumber(vertexAttachment.Name);
							editableMesh:SetPosition(vertId, vertPos);
							vertexAttachmentSet.Position = vertPos * scaling;
						end;
					end

					Selection:Set({});
					Selection:Set(selectedAttachments);
				end
			end
		end
	end)

	local save
	
	prompt:AddButton("Save", function()
		save = true;	
	end)
	
	prompt:AddButton("Cancel", function()
		save = false;	
	end)
	
	local promptFrame = prompt.Prompt;
	promptFrame.AnchorPoint = Vector2.new(1, 0);
	promptFrame.Position = UDim2.new(1, -20, 0, 20);

	repeat task.wait() until save ~= nil or not promptFrame.Parent;
	
	promptFrame:Destroy();

	liveUpdateLoop = false;
	selectedMesh:SetAttribute('OriginalSize', originalMeshSize);
	selectedMesh:ClearAllChildren();

	if not save then
		for vertId, vertPos in originalPositions do
			editableMesh:SetPosition(vertId, vertPos);
		end
	end
end

return module
]]></ProtectedString>
						<int64 name="SourceAssetId">-1</int64>
