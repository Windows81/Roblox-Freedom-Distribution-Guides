						<ProtectedString name="Source"><![CDATA[--!native
local SerializationService = game:GetService("SerializationService");

local module = {
	Icon = "rbxassetid://81480871483945",
	Name = "Pick most optimized fidelity for selected Meshes",
	LayoutOrder = 4,
	Category = "Collision"
}
local modules = script.Parent.Parent.Modules;

local rbxmParse = require(modules.rbxmParse);

local function getPerformantFidelity(original: MeshPart | UnionOperation): Enum.CollisionFidelity?
	local defaultMesh = Instance.fromExisting(original);
	
	
	local oppositeMesh = Instance.fromExisting(defaultMesh);
	local oppositeCollision = oppositeMesh.CollisionFidelity == Enum.CollisionFidelity.Default and Enum.CollisionFidelity.PreciseConvexDecomposition or Enum.CollisionFidelity.Default;
	oppositeMesh.Parent = workspace;
	oppositeMesh.CollisionFidelity = oppositeCollision;

	local defaultBuf = SerializationService:SerializeInstancesAsync({defaultMesh});
	local preciseBuf = SerializationService:SerializeInstancesAsync({oppositeMesh});

	oppositeMesh:Destroy();

	local defaultsstrChunk = rbxmParse.GetSSTR(defaultBuf, defaultMesh);

	local precisesstrChunk = rbxmParse.GetSSTR(preciseBuf, oppositeMesh);

	local currentCollisionData;
	local oppositeCollisionData;

	for i, s in defaultsstrChunk.SharedStrings do
		if s.str:sub(1,6) ~= "CSGPHS" then continue; end
		currentCollisionData = s.str;
		break;
	end
	if not currentCollisionData then return; end --Idk how this happen but disaster

	for i, s in precisesstrChunk.SharedStrings do
		if s.str:sub(1,6) ~= "CSGPHS" then continue; end
		oppositeCollisionData = s.str;
		break;
	end

	if not oppositeCollisionData then return; end
	local mostPerformant = #oppositeCollisionData <= #currentCollisionData and oppositeCollision or defaultMesh.CollisionFidelity;
	return mostPerformant;
end

function module:Run()
	local validMeshes = {} :: {[string]: {MeshPart}};
	local validUnions = {} :: {UnionOperation};
	local meshCount = 0;
	
	for _, inst in game:GetService("Selection"):Get() do

		--if not inst.CanCollide then
		--	inst.CollisionFidelity = Enum.CollisionFidelity.Box;
		--	warn(inst, '[MESH LAB] Was CanCollide false box is most performant!');

		--	continue;
		--end
		if inst:IsA('MeshPart') then
			if not validMeshes[inst.MeshId] then
				validMeshes[inst.MeshId] = {};
				meshCount+=1;
			end

			table.insert(validMeshes[inst.MeshId], inst);
		elseif inst:IsA('UnionOperation') then
			table.insert(validUnions, inst);
		end
	end
	
	if meshCount == 0 and #validUnions == 0 then
		warn(`[MESH LAB] No Meshes or Unions were selected!`);
		return;
	end
	
	if meshCount ~= 0 then
		warn(`[MESH LAB] Checking {meshCount} different meshes!`);
	end
	if #validUnions ~= 0 then
		warn(`[MESH LAB] Checking {#validUnions} different unions!`);
	end
	
	local start = os.clock();
	
	--TODO: To speed this process up we should only calculate it for 1 mesh, and clone the result to all the selected meshes with the same ID
	--This would be best for performance sake, but it would require preserving the hierarchy, see "SaveHulls"
	for meshId, meshes in validMeshes do 
		local mostPerformant = getPerformantFidelity(meshes[1]);
		if not mostPerformant then continue; end
		
		warn(meshes[1], `[MESH LAB] {meshes[1].MeshId} is most performant using {mostPerformant.Name}`)
		for _,v in meshes do
			v.CollisionFidelity = Enum.CollisionFidelity.Box; -- forces the update
			v.CollisionFidelity = mostPerformant;
		end
	end
	
	for _, union in validUnions do
		local mostPerformant = getPerformantFidelity(union);
		if not mostPerformant then continue; end
		
		warn(union, `[MESH LAB] {union.Name} is most performant using {mostPerformant.Name}`)
		union.CollisionFidelity = Enum.CollisionFidelity.Box; -- forces the update
		union.CollisionFidelity = mostPerformant;
	end
end


return module
]]></ProtectedString>
