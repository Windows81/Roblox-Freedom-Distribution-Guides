								<string name="Name">Edgebreaker</string>
								<string name="ScriptGuid">{CCE92CCD-17F6-4601-AF68-0EC6F384ADF8}</string>
								<ProtectedString name="Source"><![CDATA[--!optimize 2
--!native

local Edgebreaker = {};

function Edgebreaker.DecodeHulls(clersData: buffer, totalBits: number, hullCount: number, allVertices: {Vector3}, totalFaces: number)
	local hulls = {}
	local bitPos = 0
	local totalWords = (totalBits + 31) // 32

	local globalVertOffset = 0 

	local function readBit()
		if bitPos >= totalBits then error("read too far") end

		local wordIdx = bitPos // 32
		local bitInWord = bitPos % 32

		local bitsInThisWord = 32
		if wordIdx == totalWords - 1 then
			bitsInThisWord = totalBits % 32
			if bitsInThisWord == 0 then bitsInThisWord = 32 end
		end

		local shift = bitsInThisWord - bitInWord - 1
		local word = buffer.readu32(clersData, wordIdx * 4)
		bitPos += 1

		return bit32.band(bit32.rshift(word, shift), 1)
	end

	local adjacencyTable
	local indexTable
	local currentTriangleIndex = 0
	local vertexCounter = 0

	local function GetNextEdge(edgeIndex: number): number
		return if (edgeIndex % 3) < 2 then 1 else -2
	end

	local function GetPrevEdge(edgeIndex: number): number
		return if (edgeIndex % 3) > 0 then 1 else -2
	end

	local function zipBoundary(cursorEdge)
		local currentEdge = cursorEdge
		local safetyOuter = 0

		while true do
			if adjacencyTable[currentEdge + 1] ~= -2 then break end

			safetyOuter += 1
			if safetyOuter > 1000 then error("? zip") end

			local nextEdgeOffset = GetNextEdge(currentEdge)
			local candidateEdge = currentEdge + nextEdgeOffset

			if adjacencyTable[candidateEdge + 1] >= 0 then
				local safetyInner = 0
				while true do
					safetyInner += 1
					if safetyInner > 1000 then error("? zip") end

					local oppositeEdge = adjacencyTable[candidateEdge + 1]
					local nextOfOpposite = GetNextEdge(oppositeEdge)
					candidateEdge = oppositeEdge + nextOfOpposite

					if adjacencyTable[candidateEdge + 1] < 0 then break end
				end
			end

			if adjacencyTable[candidateEdge + 1] ~= -1 then break end

			adjacencyTable[currentEdge + 1] = candidateEdge
			adjacencyTable[candidateEdge + 1] = currentEdge

			local prevOffset = GetPrevEdge(currentEdge)
			currentEdge -= prevOffset

			local previousEdge = currentEdge
			local candidatePrevOffset = GetPrevEdge(candidateEdge)
			local previousCandidateEdge = candidateEdge - candidatePrevOffset

			indexTable[currentEdge - GetPrevEdge(currentEdge) + 1] = indexTable[previousCandidateEdge + 1]

			local connectedEdge = adjacencyTable[currentEdge + 1]
			if connectedEdge >= 0 then
				local safetyInner = 0
				while true do
					safetyInner += 1
					if safetyInner > 1000 then error("? zip") end
					if candidateEdge == previousEdge then break end

					local prevOfConnected = GetPrevEdge(connectedEdge)
					previousEdge = connectedEdge - prevOfConnected

					local prevOfPrev = GetPrevEdge(previousEdge)

					indexTable[previousEdge - prevOfPrev + 1] = indexTable[previousCandidateEdge + 1]

					connectedEdge = adjacencyTable[previousEdge + 1]
					if connectedEdge < 0 then break end
				end
			end

			if adjacencyTable[currentEdge + 1] >= 0 then
				local safetyInner = 0
				while true do
					safetyInner += 1
					if safetyInner > 1000 then error("? zip") end
					if currentEdge == candidateEdge then break end

					local nextLink = adjacencyTable[currentEdge + 1]
					local prevOfNext = GetPrevEdge(nextLink)
					currentEdge = nextLink - prevOfNext

					if adjacencyTable[currentEdge + 1] < 0 then break end
				end
			end
		end

		return currentEdge
	end

	local function decodeRecursive(cursorEdge, depth)
		if depth > 500 then error("? decode") end

		local iterCount = 0
		while true do
			iterCount += 1
			if iterCount > 10000 then error("? decode") end

			currentTriangleIndex += 1
			local triIdx = currentTriangleIndex
			local triBaseEdge = 3 * triIdx

			if adjacencyTable[triBaseEdge + 1] == nil then
				adjacencyTable[triBaseEdge + 1] = -3
				adjacencyTable[triBaseEdge + 2] = -3
				adjacencyTable[triBaseEdge + 3] = -3
				indexTable[triBaseEdge + 1] = 0
				indexTable[triBaseEdge + 2] = 0
				indexTable[triBaseEdge + 3] = 0
			else
				adjacencyTable[triBaseEdge + 1] = -3
				adjacencyTable[triBaseEdge + 2] = -3
				adjacencyTable[triBaseEdge + 3] = -3
			end

			adjacencyTable[cursorEdge + 1] = triBaseEdge
			adjacencyTable[triBaseEdge + 1] = cursorEdge

			indexTable[triBaseEdge + 1 + 1] = indexTable[cursorEdge - GetPrevEdge(cursorEdge) + 1]
			indexTable[triBaseEdge + 2 + 1] = indexTable[cursorEdge + GetNextEdge(cursorEdge) + 1]

			cursorEdge = triBaseEdge + 1

			local bit = readBit()

			if bit == 0 then -- C
				vertexCounter += 1
				indexTable[triBaseEdge + 1] = vertexCounter 
				local nextOffset = GetNextEdge(cursorEdge)
				adjacencyTable[cursorEdge + nextOffset + 1] = -1
			else
				local b2 = readBit()
				local b3 = readBit()
				local op = 4 + (if b2 == 1 then 2 else 0) + (if b3 == 1 then 1 else 0)

				if op == 6 then -- R
					local nextEdge = cursorEdge + GetNextEdge(cursorEdge)
					adjacencyTable[nextEdge + 1] = -2
					zipBoundary(nextEdge)
				elseif op == 5 then -- L
					adjacencyTable[cursorEdge + 1] = -2
					cursorEdge += GetNextEdge(cursorEdge)
				elseif op == 4 then -- S
					if not decodeRecursive(cursorEdge, depth + 1) then return false end
					cursorEdge += GetNextEdge(cursorEdge)
				elseif op == 7 then -- E
					adjacencyTable[cursorEdge + 1] = -2
					local nextEdge = cursorEdge + GetNextEdge(cursorEdge)
					adjacencyTable[nextEdge + 1] = -2
					zipBoundary(nextEdge)
					return true
				else
					return false
				end
			end
		end
	end

	local estCapacity = math.max((totalFaces or 0) * 3, 1024)

	for h = 1, hullCount do
		currentTriangleIndex = 0
		vertexCounter = 2 

		adjacencyTable = table.create(estCapacity, -3)
		indexTable = table.create(estCapacity, 0)

		indexTable[1] = 0; indexTable[2] = 1; indexTable[3] = 2
		adjacencyTable[1] = -1; adjacencyTable[3] = -1

		local success = decodeRecursive(1, 0)

		if success then
			local hullVerts = {}
			local hullTriangles = {}
			local maxLocalIdx = 0

			for t = 0, currentTriangleIndex do
				local base = 3 * t
				local i0 = indexTable[base + 1]
				local i1 = indexTable[base + 2]
				local i2 = indexTable[base + 3]

				if i0 ~= i1 and i0 ~= i2 and i1 ~= i2 then
					table.insert(hullTriangles, {i0 + 1, i1 + 1, i2 + 1})
					maxLocalIdx = math.max(maxLocalIdx, i0, i1, i2)
				end
			end

			local vertsConsumed = maxLocalIdx + 1
			for v = 1, vertsConsumed do
				table.insert(hullVerts, allVertices[globalVertOffset + v])
			end

			table.insert(hulls, {
				Vertices = hullVerts,
				Triangles = hullTriangles
			})

			globalVertOffset += vertsConsumed
		else
			warn(`Hull {h} failed to decode`)
			break
		end
	end

	return hulls
end

return Edgebreaker]]></ProtectedString>
