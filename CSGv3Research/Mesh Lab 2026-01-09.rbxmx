					<string name="ScriptGuid">{5E89278C-4634-4533-8494-0648B4192638}</string>
					<ProtectedString name="Source"><![CDATA[local TweenService = game:GetService("TweenService");

local MeshLab = {}

local ScalingController = require(script.Parent.ScalingController);

function MeshLab._categoryHandler(tool: table, toolFrame: Frame, gui: ScreenGui)
	local category = tool.Category;
	local frame = gui.Frame;

	if category then
		
		local function updateLayoutOrder(category)
			local smallestLayoutOrder = math.huge
			for _, toolFrame in category.Content:GetChildren() do
				if toolFrame.Name == "Tool" and toolFrame.LayoutOrder < smallestLayoutOrder then
					smallestLayoutOrder = toolFrame.LayoutOrder;
				end
				category.LayoutOrder = smallestLayoutOrder;
			end
		end
		
		local foundCategory = frame:FindFirstChild("Category_"..category);
		if foundCategory then
			toolFrame.Parent = foundCategory.Content;
			updateLayoutOrder(foundCategory);
		else
			local newCategory = gui.Prefabs.Category:Clone();
			newCategory.Name = `Category_{category}`;
			newCategory.Topbar.Title.Text = category;
			
			newCategory.Topbar.FoldButton.MouseButton1Click:Connect(function()
				newCategory.Content.Visible = not newCategory.Content.Visible;
				newCategory.Topbar.FoldButton.Arrow.ImageLabel.Rotation = newCategory.Content.Visible and 90 or 0;
			end)
			
			newCategory.Parent = frame;
			toolFrame.Parent = newCategory.Content;
			updateLayoutOrder(newCategory)
		end
	else
		toolFrame.Parent = frame
	end
end

function MeshLab.LoadTools(gui: ScreenGui, tools: {ModuleScript}, promptLibrary)
	local frame = gui.Frame;
	local toolPrefab = gui.Prefabs.Tool;

	local baseColor = toolPrefab.BackgroundColor3
	local hoverColor = Color3.new(baseColor.R + 0.1, baseColor.G + 0.1, baseColor.B + 0.1);

	for _, toolModule in tools do
		if toolModule:GetAttribute("Hidden") then continue end;
		
		local tool = require(toolModule);
		
		local toolFrame = toolPrefab:Clone()
		toolFrame.Tooltip.Text = tool.Name
		toolFrame.Icon.Image = tool.Icon
		toolFrame.LayoutOrder = tool.LayoutOrder
		MeshLab._categoryHandler(tool, toolFrame, gui);
		
		toolFrame.InputBegan:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				toolFrame.Tooltip.Visible = true;
				TweenService:Create(toolFrame, TweenInfo.new(0.3), {BackgroundColor3 = hoverColor}):Play();
			elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
				tool:Run(promptLibrary)
			end
		end)
		
		toolFrame.InputEnded:Connect(function(input:InputObject)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				toolFrame.Tooltip.Visible = false;
				TweenService:Create(toolFrame, TweenInfo.new(0.3), {BackgroundColor3 = baseColor}):Play();
			end
		end)
	end
end

function MeshLab.CreatePrompt(gui: ScreenGui)
	return function()
		local prompt = gui.Prefabs.Prompt:Clone();
		prompt.Parent = gui;
		prompt.UIScale.Scale = gui.Frame.UIScale.Scale;
		
		local dragDetector = prompt.UIDragDetector;
		local dragBar = prompt.Drag;
		
		local base = dragBar.BackgroundColor3
		local hold = Color3.new(
			math.clamp(base.R + 0.2, 0, 1),
			math.clamp(base.G + 0.2, 0, 1),
			math.clamp(base.B + 0.2, 0, 1)
		)
		
		dragDetector.DragStart:Connect(function()
			dragBar.BackgroundColor3 = hold
		end)
		
		dragDetector.DragEnd:Connect(function()
			dragBar.BackgroundColor3 = base
		end)
		
		local layoutOrder = 0;
		
		return {
			Prompt = prompt,
			
			AddToggle = function(self, label, default)
				local toggle = gui.Prefabs.PromptPrefabs.Toggle:Clone();
				toggle.Label.Text = label or '';
				toggle.LayoutOrder = layoutOrder;
				toggle.Parent = prompt.Content;
				layoutOrder += 1;
				
				local check = toggle.ToggleButton.Check
				check.Visible = default;
				
				toggle.ToggleButton.MouseButton1Click:Connect(function()
					check.Visible = not check.Visible
				end)
				
				toggle.Parent = prompt.Content
				
				return function() return check.Visible end;
			end,
			
			AddLabel = function(self, label)
				local textLabel = gui.Prefabs.PromptPrefabs.Label:Clone();
				textLabel.Text = label or '';
				textLabel.LayoutOrder = layoutOrder;
				textLabel.Parent = prompt.Content;
				layoutOrder += 1;
				
				return label;
			end,
			
			AddButton = function(self, text, callback)
				local button = gui.Prefabs.PromptPrefabs.Button:Clone();
				button.Text = text or '';
				button.LayoutOrder = layoutOrder;
				button.Parent = prompt.Content;
				layoutOrder += 1;
				
				button.MouseButton1Click:Connect(callback)
			end,
			
			AddUVMap = function(self)
				local map = gui.Prefabs.PromptPrefabs.UVDisplay:Clone();
				map.LayoutOrder = layoutOrder;
				map.Parent = prompt.Content;
				layoutOrder += 1;
				
				return map;
			end,
			
			
		}
	end
end

function MeshLab._updateTooltips(gui: ScreenGui, left)
	local frame = gui.Frame;

	local newPos = left and UDim2.new(1, 20, 0.5, 0) or UDim2.new(0, -20, 0.5, 0)
	local newAnchor = left and Vector2.new(0, 0.5) or Vector2.new(1, 0.5)

	for _, toolFrame in frame:GetChildren() do
		if toolFrame.Name ~= "Tool" then continue end;
		toolFrame.Tooltip.AnchorPoint = newAnchor;
		toolFrame.Tooltip.Position = newPos;
	end
end

function MeshLab.StartDragger(gui: ScreenGui, mouse)
	local frame = gui.Frame
	local dragBar = frame.Drag
	local dragDetector: UIDragDetector = dragBar.Hitbox.UIDragDetector

	local base = dragBar.BackgroundColor3
	local hold = Color3.new(
		math.clamp(base.R + 0.2, 0, 1),
		math.clamp(base.G + 0.2, 0, 1),
		math.clamp(base.B + 0.2, 0, 1)
	)

	local SNAP_MARGIN = 20
	local dragOffset

	local function updateDrag()
		if not dragOffset then return end
		local mousePos = Vector2.new(mouse.X, mouse.Y)
		local topLeft = mousePos - dragOffset
		frame.Position = UDim2.fromOffset(topLeft.X, topLeft.Y)
	end

	dragDetector.DragStart:Connect(function()
		dragBar.BackgroundColor3 = hold
		local currentAnchorScreen = frame.AbsolutePosition + (frame.AnchorPoint * frame.AbsoluteSize)
		dragOffset = Vector2.new(mouse.X, mouse.Y) - currentAnchorScreen
	end)

	dragDetector.DragContinue:Connect(function()
		updateDrag()
	end)

	dragDetector.DragEnd:Connect(function()
		dragBar.BackgroundColor3 = base
		dragOffset = nil

		local parentPos = frame.Parent.AbsolutePosition
		local parentW = frame.Parent.AbsoluteSize.X
		local w = frame.AbsoluteSize.X
		local ax = frame.AnchorPoint.X

		local localLeft = frame.AbsolutePosition.X - parentPos.X
		local centerX = localLeft + w * 0.5
		local snapLeft = (centerX < parentW * 0.5)

		local targetX
		if snapLeft then
			targetX = SNAP_MARGIN + ax * w
		else
			targetX = parentW - SNAP_MARGIN - (1 - ax) * w
		end

		MeshLab._updateTooltips(gui, snapLeft)

		local goal = {
			Position = UDim2.new(0, targetX, frame.Position.Y.Scale, frame.Position.Y.Offset)
		}
		TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), goal):Play()
	end)
end


function MeshLab:Initialize(gui: ScreenGui, plugin)
	local promptLibrary = self.CreatePrompt(gui);
	
	self.LoadTools(gui, script.Parent.Tools:GetChildren(), promptLibrary);
	self.StartDragger(gui, plugin:GetMouse());
	ScalingController:Initialize(gui);
end

return MeshLab
]]></ProtectedString>
