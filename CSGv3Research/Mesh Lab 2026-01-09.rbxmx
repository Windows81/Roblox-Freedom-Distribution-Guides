						<string name="Name">rbxmParse</string>
						<string name="ScriptGuid">{4107CA4A-58D9-4F88-8F1B-A56B7A3EA7CC}</string>
						<ProtectedString name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage");
local HttpService = game:GetService("HttpService");

local module = {};
export type sstrChunk = {
	CompressedLength: number,
	StartsAt: number, --Where the SSTR chunk starts
	UncompressedLength: 'LZ4' | 'ZSTD' | 'Uncompressed',
	Length: number, --True length of the chunk
	Name: 'SSTR',
	NumSharedStrings: number,
	SharedStrings: {
		{
			md5: string,
			str: string
		}
	}
}

--Intakes rbxm file and spits out the SSTR chunk
function module.GetSSTR(b: buffer, mesh: MeshPart): sstrChunk
	local LZ4 = require(script.helper.LZ4);
	local chunk = {};
	
	local cursor = 32; --We start at 32 because I dont care about the header
	
	--Loop through chunks
	local currentChunk;
	while currentChunk ~= 'END' do
		currentChunk = buffer.readstring(b, cursor, 4);
		cursor+=4;
		if currentChunk == 'SSTR' then break; end
		
		local compressedLength = buffer.readu32(b, cursor);
		cursor+=4;
		local uncompressedLength = buffer.readu32(b, cursor);
		cursor+=8; --This is because we read the u32 and to skip the reserved which is also 4 byte
		
		cursor += compressedLength == 0 and uncompressedLength or compressedLength;
	end
	
	if currentChunk ~= 'SSTR' then return; end	
	chunk.StartsAt = cursor-4;
	chunk.Name = 'SSTR';
	chunk.CompressedLength = buffer.readu32(b, cursor);
	cursor+=4;
	chunk.UncompressedLength = buffer.readu32(b, cursor);
	cursor+=4;
	local reserved = buffer.readu32(b, cursor); --I assume 
	cursor+=4;
	
	local decompressed;
	if chunk.CompressedLength ~= 0 then
		chunk.Length = chunk.CompressedLength;
		local firstFour = buffer.readu32(b, cursor);
		
		chunk.CompressionType = firstFour == 0xFD2FB528 and 'ZSTD' or 'LZ4';
		local compressedData = buffer.create(chunk.CompressedLength);
		buffer.copy(compressedData, 0, b, cursor, chunk.CompressedLength);

		if chunk.CompressionType == 'LZ4' then
			if reserved ~= 0 then
				error('Unsupported LZ4 reserved value: ' .. reserved);
			end
			
			decompressed = LZ4(compressedData, chunk.UncompressedLength);
		else
			--This is cursed but here we go 
			decompressed = HttpService:JSONDecode(`\{"m":null,"t":"buffer","base64":"{buffer.tostring(compressedData)}"\}`)
		end
		
		if not decompressed then warn('Couldnt decompress!') return; end
	else
		chunk.Length = chunk.UncompressedLength;
		decompressed = buffer.create(chunk.UncompressedLength);
		buffer.copy(decompressed, 0, chunk, cursor, chunk.UncompressedLength);
		chunk.CompressionType = 'Uncompressed'
	end
	
	local chunkCursor = 0;
	local sstrVersion = buffer.readu32(decompressed, chunkCursor);
	chunkCursor+=4;
	if sstrVersion ~= 0 then error('SSTR has incorrect version'); end
	chunk.NumSharedStrings = buffer.readu32(decompressed, chunkCursor);
	chunkCursor+=4;

	chunk.SharedStrings = {};

	for i = 1, chunk.NumSharedStrings do
		local md5 = buffer.readstring(decompressed, chunkCursor, 16);

		chunkCursor+=16;
		local length = buffer.readu32(decompressed, chunkCursor);
		chunkCursor+=4;

		local sharedStr = buffer.readstring(decompressed, chunkCursor, length);
		chunkCursor+=length;
		
		table.insert(chunk.SharedStrings, {md5 = md5, str = sharedStr});
	end
	
	return chunk;
end

local function encode(buf: buffer): string
	local out = HttpService:JSONEncode(buf)
	return out:match('base64":"(.-)"');
end

--Returns the buffer, compressed size, uncompressed size
function module.ConvertSSTR(sstrChunk: sstrChunk): (buffer, number, number)
    local b64 = require(script.helper.b64);

	local chunkSize = 8; --Version + Amount of shared strings
	for _, v in sstrChunk.SharedStrings do
		chunkSize += 16 + 4 + #v.str; --MD5 + string length + string
	end
	
	local cursor = 0;
	local b = buffer.create(chunkSize);
	buffer.writeu32(b, cursor, 0); --Version
	cursor+=4;
	buffer.writeu32(b, cursor, #sstrChunk.SharedStrings); --Amount of shared strings
	cursor+=4;
	for _, v in sstrChunk.SharedStrings do
		if #v.md5 ~= 16 then error('MD5 is not 16 bytes!'); end
		buffer.writestring(b, cursor, v.md5, 16);
		cursor+=16;
		buffer.writeu32(b, cursor, #v.str);
		cursor+=4;
		buffer.writestring(b, cursor, v.str);
		cursor += #v.str;
	end
	
	--local compressedBuf = buffer.fromstring(b64.decode(encode(b)));
	--if buffer.len(b) >= buffer.len(compressedBuf) then --Compressed!
	--	warn(buffer.readu32(compressedBuf, 0) == 0xFD2FB528)
	--	return compressedBuf, buffer.len(compressedBuf), buffer.len(b);
	--end
	
	return b, 0, buffer.len(b);
end

function module.SaveSSTR(target: buffer, sstrChunk: sstrChunk): buffer
	local sstrBuffer, compressedSize, uncompressedSize = module.ConvertSSTR(sstrChunk);
	local originalSSTRSize = 16 + sstrChunk.Length;
	local newSize = buffer.len(target) - originalSSTRSize + 16 + buffer.len(sstrBuffer);
	local b = buffer.create(newSize);
	local cursor = 0;

	buffer.copy(b, cursor, target, 0, sstrChunk.StartsAt);
	cursor = sstrChunk.StartsAt;

	--warn(compressedSize, uncompressedSize);
	buffer.writestring(b, cursor, 'SSTR');
	cursor += 4;

	buffer.writeu32(b, cursor, compressedSize);
	cursor += 4;

	buffer.writeu32(b, cursor, uncompressedSize);
	cursor += 4;

	buffer.writeu32(b, cursor, 0);
	cursor += 4;

	buffer.copy(b, cursor, sstrBuffer, 0);
	cursor += buffer.len(sstrBuffer);

	local afterSSTRStart = sstrChunk.StartsAt + originalSSTRSize;
	buffer.copy(b, cursor, target, afterSSTRStart);

	return b;
end

return module;]]></ProtectedString>
