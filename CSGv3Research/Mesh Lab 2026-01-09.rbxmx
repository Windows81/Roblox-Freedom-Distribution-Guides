						<string name="Name">QuickHull</string>
						<string name="ScriptGuid">{77DD1095-D40C-45FD-90DF-21B573FBD92A}</string>
						<ProtectedString name="Source"><![CDATA[--!native
--!optimize 2

local QuickHull = {}
QuickHull.__index = QuickHull

local Workspace = game:GetService("Workspace")
local EPS = 1e-6
local BEAM_WIDTH = 0.06
local BEAM_COLOR = Color3.fromRGB(0, 0, 0)

local function dot(a, b)
	return a:Dot(b)
end

local function cross(a, b)
	return a:Cross(b)
end

local function edgeKey(u, v)
	return tostring(u) .. "|" .. tostring(v)
end

local function undirectedKey(u, v)
	return (
		u < v and tostring(u) .. "~" .. tostring(v)
			or tostring(v) .. "~" .. tostring(u)
	)
end

function QuickHull.collectVertices(meshParts)
	local pts = {}

	for _, mp in ipairs(meshParts) do
		if mp and mp:IsA("MeshPart") then
			local ed = mp.MeshContent and mp.MeshContent.Object

			if ed then
				local cf = mp.CFrame

				for _, vid in ipairs(ed:GetVertices()) do
					local lp = ed:GetPosition(vid)

					table.insert(pts, cf:PointToWorldSpace(lp))
				end
			end
		end
	end

	return pts
end

function QuickHull.dedupe(points, tol)
	tol = tol or 1e-5

	local seen = {}
	local out = {}

	for _, p in ipairs(points) do
		local kx = math.floor(p.X / tol + 0.5)
		local ky = math.floor(p.Y / tol + 0.5)
		local kz = math.floor(p.Z / tol + 0.5)

		local key = kx .. ":" .. ky .. ":" .. kz

		if not seen[key] then
			seen[key] = true

			table.insert(out, p)
		end
	end

	return out
end

local function computeNormal(a, b, c)
	local n = cross(b - a, c - a)

	if n.Magnitude > 0 then
		return n.Unit
	else
		return Vector3.new(0, 0, 0)
	end
end

local function makeFace(aIdx, bIdx, cIdx, points)
	local a, b, c = points[aIdx], points[bIdx], points[cIdx]

	local n = computeNormal(a, b, c)

	return {
		a = aIdx,
		b = bIdx,
		c = cIdx,
		normal = n,

		outside = {},
		neighbors = {},
	}
end

local function faceDistance(face, pIdx, points)
	return dot(points[pIdx] - points[face.a], face.normal)
end

local function flipFace(face, points)
	face.b, face.c = face.c, face.b

	face.normal = computeNormal(points[face.a], points[face.b], points[face.c])
end

local function orientFaceOutward(face, interiorVec, points)
	if dot(interiorVec - points[face.a], face.normal) > 0 then
		flipFace(face, points)
	end
end

local function buildInitialTetra(points)
	local minX_i, maxX_i = 1, 1

	for i = 2, #points do
		if points[i].X < points[minX_i].X then
			minX_i = i
		end

		if points[i].X > points[maxX_i].X then
			maxX_i = i
		end
	end

	local far_i, bestArea = nil, -1

	for i = 1, #points do
		if i ~= minX_i and i ~= maxX_i then
			local area = cross(
				points[maxX_i] - points[minX_i],
				points[i] - points[minX_i]
			).Magnitude

			if area > bestArea then
				bestArea = area
				far_i = i
			end
		end

	end
	local planeN = cross(points[maxX_i] - points[minX_i], points[far_i] - points[minX_i])

	local fourth_i, bestDist = nil, -1

	for i = 1, #points do
		if i ~= minX_i and i ~= maxX_i and i ~= far_i then
			local d = math.abs(dot(planeN.Unit, points[i] - points[minX_i]))
			if d > bestDist then
				bestDist = d
				fourth_i = i
			end
		end
	end

	local used = {}

	used[minX_i] = true
	used[maxX_i] = true
	used[far_i] = true
	used[fourth_i] = true

	local interior = (
		points[minX_i]
			+ points[maxX_i]
			+ points[far_i]
			+ points[fourth_i]
	) / 4

	local faces = {
		makeFace(minX_i, maxX_i, far_i, points),
		makeFace(minX_i, far_i, fourth_i, points),
		makeFace(minX_i, fourth_i, maxX_i, points),
		makeFace(maxX_i, fourth_i, far_i, points),
	}

	for _, f in ipairs(faces) do
		orientFaceOutward(f, interior, points)
	end

	return faces, interior, used
end

local function registerFace(face, edgeToFace)
	for _, e in ipairs({ { face.a, face.b }, { face.b, face.c }, {
		face.c,
		face.a,
		} }) do
		local k = edgeKey(e[1], e[2])

		edgeToFace[k] = face

		local opp = edgeToFace[edgeKey(e[2], e[1])]

		if opp then
			face.neighbors[k] = opp

			opp.neighbors[edgeKey(e[2], e[1])] = face
		end
	end
end

local function unregisterFace(face, edgeToFace)
	for _, e in ipairs({ { face.a, face.b }, { face.b, face.c }, {
		face.c,
		face.a,
		} }) do
		local k = edgeKey(e[1], e[2])

		edgeToFace[k] = nil

		local opp = edgeToFace[edgeKey(e[2], e[1])]

		if opp then
			opp.neighbors[edgeKey(e[2], e[1])] = nil
		end
	end
end

local function assignPoints(pointIndices, faces, points)
	for _, f in ipairs(faces) do
		f.outside = {}
	end

	for _, pIdx in ipairs(pointIndices) do
		local bestFace, bestD = nil, EPS

		for _, f in ipairs(faces) do
			local d = faceDistance(f, pIdx, points)

			if d > bestD then
				bestD = d
				bestFace = f
			end
		end

		if bestFace then
			table.insert(bestFace.outside, pIdx)
		end
	end
end

local function findVisibleFaces(startFace, eyeIdx, points)
	local stack = { startFace }

	local visited = {}
	local visible = {}

	while #stack > 0 do
		local f = table.remove(stack)

		if not visited[f] then
			visited[f] = true

			if faceDistance(f, eyeIdx, points) > EPS then
				table.insert(visible, f)

				for _, n in pairs(f.neighbors) do
					if n and not visited[n] then
						table.insert(stack, n)
					end
				end
			end
		end
	end

	local visibleSet = {}

	for _, f in ipairs(visible) do
		visibleSet[f] = true
	end

	return visible, visibleSet
end

local function buildHorizon(visibleList, visibleSet, edgeToFace)
	local horizon = {}

	for _, f in ipairs(visibleList) do
		for _, e in ipairs({ { f.a, f.b }, { f.b, f.c }, { f.c, f.a } }) do
			local opp = edgeToFace[edgeKey(e[2], e[1])]

			if not opp or not visibleSet[opp] then
				table.insert(horizon, { e[1], e[2] })
			end
		end
	end

	return horizon
end

function QuickHull.compute(points)
	if #points < 4 then
		error("Need at least 4 points")
	end

	local pts = points

	local faces, interiorVec, usedMap = buildInitialTetra(pts)

	local edgeToFace = {}

	for _, f in ipairs(faces) do
		registerFace(f, edgeToFace)
	end

	local candidates = {}

	for i = 1, #pts do
		if not usedMap[i] then
			table.insert(candidates, i)
		end
	end

	assignPoints(candidates, faces, pts)

	while true do
		local faceWithOutside = nil

		for _, f in ipairs(faces) do
			if #f.outside > 0 then
				faceWithOutside = f

				break
			end
		end

		if not faceWithOutside then
			break
		end

		local farIdx = faceWithOutside.outside[1]

		local maxD = faceDistance(faceWithOutside, farIdx, pts)

		for _, pIdx in ipairs(faceWithOutside.outside) do
			local d = faceDistance(faceWithOutside, pIdx, pts)

			if d > maxD then
				maxD = d
				farIdx = pIdx
			end
		end

		local visibleList, visibleSet = findVisibleFaces(faceWithOutside, farIdx, pts)

		local reassignMap = {}
		local reassignList = {}

		for _, vf in ipairs(visibleList) do
			for _, pIdx in ipairs(vf.outside) do
				if pIdx ~= farIdx and not reassignMap[pIdx] then
					reassignMap[pIdx] = true

					table.insert(reassignList, pIdx)
				end
			end
		end

		local horizon = buildHorizon(visibleList, visibleSet, edgeToFace)

		for _, vf in ipairs(visibleList) do
			unregisterFace(vf, edgeToFace)
		end

		for i = #faces, 1, -1 do
			if visibleSet[faces[i]] then
				table.remove(faces, i)
			end
		end

		local newFaces = {}

		for _, e in ipairs(horizon) do
			local newF = makeFace(e[1], e[2], farIdx, pts)

			orientFaceOutward(newF, interiorVec, pts)
			registerFace(newF, edgeToFace)
			table.insert(faces, newF)
			table.insert(newFaces, newF)
		end

		if #reassignList > 0 then
			for _, nf in ipairs(newFaces) do
				nf.outside = {}
			end

			for _, pIdx in ipairs(reassignList) do
				local bestFace, bestD = nil, EPS

				for _, nf in ipairs(newFaces) do
					local d = faceDistance(nf, pIdx, pts)

					if d > bestD then
						bestD = d
						bestFace = nf
					end
				end

				if bestFace then
					table.insert(bestFace.outside, pIdx)
				end
			end
		end

		for _, f in ipairs(faces) do
			for i = #f.outside, 1, -1 do
				if f.outside[i] == farIdx then
					table.remove(f.outside, i)
				end
			end
		end
	end

	return faces
end

