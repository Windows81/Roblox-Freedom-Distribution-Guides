				<string name="ScriptGuid">{B0698DBC-9AE8-4BCC-B44E-2EE1E6796726}</string>
				<ProtectedString name="Source"><![CDATA[local RunService = game:GetService('RunService');
local CoreGui = game:GetService('CoreGui');
local Selection = game:GetService('Selection');

local toolbar;

function SetupButton(buttonInfo, module, gui: ScreenGui)
	local pluginButton = toolbar:CreateButton(
		buttonInfo.Name,
		buttonInfo.Description,
		buttonInfo.Icon
	);
	
	pluginButton.ClickableWhenViewportHidden = false;

	local currentGui;
	
	pluginButton.Click:Connect(function()
		if currentGui then
			currentGui:Destroy(); 
			currentGui = nil;
			pluginButton:SetActive(false)
		else
			local oldUI = CoreGui:FindFirstChild(gui.Name);
			if oldUI then
				oldUI:Destroy();
			end
			
			currentGui =  gui:Clone();
			currentGui.Parent = CoreGui;

			module:Initialize(currentGui, plugin, Selection:Get()[1]);
			pluginButton:SetActive(true)
		end
	end)
end

if RunService:IsEdit() then

	toolbar = plugin:CreateToolbar('Mesh Lab');

	
	SetupButton(
		{
			Name = 'Mesh Lab',
			Description = 'Quickly edit meshes!',
			Icon = 'rbxassetid://120458884168709'
		},

		require(script.MeshLab),
		script.Parent.MeshLab
	)


end]]></ProtectedString>
