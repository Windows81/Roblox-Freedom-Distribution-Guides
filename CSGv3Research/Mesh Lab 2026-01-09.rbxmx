					<Item class="ModuleScript" referent="RBX80775B0A0DC54280A203AD476462E738">
						<Properties>
							<BinaryString name="AttributesSerialize"></BinaryString>
							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">CSGPHS8</string>
							<string name="ScriptGuid">{1990A513-532C-48B3-B477-5050572ED966}</string>
							<ProtectedString name="Source"><![CDATA[local EncodingService = game:GetService("EncodingService");

type Box = {
	Min: Vector3,
	Max: Vector3
}

type CSGPHS8 = {
	GeomType: number,

	HullCount: number,

	TotalVerts: number,
	TotalFaces: number,

	FirstHullVertCount: number,
	FirstHullFaceCount: number,

	RawHullsSize: number,

	CLERSbitCount: number,
	CLERSbufferSize: number,

	VerticesSize: number,

	BoundingBox: Box,

	RawHulls: buffer,
	CLERSbuffer: buffer,
	Vertices: {Vector3}
}

local DEBUG = false;

local function tobytestr(buf)
	return buffer.tostring(buf):gsub(".", function(x) return `\\{x:byte()}` end)
end

local function ParseV8(collisionData: buffer) : CSGPHS8
	local count = 0;

	local function readu8()
		local int = buffer.readu8(collisionData, count);
		count += 1;
		return int;
	end

	local function readu32()
		local int = buffer.readu32(collisionData, count);
		count += 4;
		return int;
	end

	local function readf32()
		local f32 = buffer.readf32(collisionData, count);
		count += 4;
		return f32;
	end

	local function readu8chain(n)
		local chain =  buffer.readstring(collisionData, count, n);
		count += n;
		return buffer.fromstring(chain);
	end

	local function readstr(n)
		local str = buffer.readstring(collisionData, count, n);
		count += n;
		return str;
	end

	local function readVector3()
		return Vector3.new(readf32(), readf32(), readf32())
	end

	local V8 : CSGPHS8 = {} do
		assert(readstr(6) == "CSGPHS")
		assert(readu32() == 8)

		V8.GeomType = readu8()
		readu8() -- reserved/unused/0 (pad?)

		do -- COMPRESSION CHECK
			if readu32() == 0xFD2FB528 then

				local collisionDataString = buffer.tostring(collisionData);
				local compressedBuffer = buffer.fromstring(collisionDataString:sub(13));
				local decompressed = EncodingService:DecompressBuffer(compressedBuffer, Enum.CompressionAlgorithm.Zstd);
				collisionData = buffer.fromstring(collisionDataString:sub(1, 12)..buffer.tostring(decompressed));
			end

			count -= 4 -- REVERT COMPRESSION CHECK INCR
		end

		V8.HullCount = readu32();

		V8.TotalVerts = readu32();
		V8.TotalFaces = readu32();

		V8.FirstHullVertCount = readu32();
		V8.FirstHullFaceCount = readu32();

		V8.RawHullsSize = readu32();
		V8.CLERSbitCount = readu32();

		V8.CLERSbufferSize = readu32();
		V8.VerticesSize = readu32();

		V8.BoundingBox = {
			Min = readVector3();
			Max = readVector3();
		};

		V8.RawHulls = readu8chain(V8.RawHullsSize);
		V8.CLERSbuffer = readu8chain(V8.CLERSbufferSize);

		V8.Vertices = {};
		for i = 1, V8.TotalVerts do
			table.insert(V8.Vertices, readVector3());
		end
	end

	return V8
end


local Edgebreaker = require(script.Edgebreaker);

local function ParseRawHullData(hullData: buffer)
	local size = buffer.len(hullData)
	if size == 0 then return {} end

	local offset = 0

	local function readu32()
		local int = buffer.readu32(hullData, offset)
		offset += 4
		return int
	end

	local function readf32()
		local f = buffer.readf32(hullData, offset)
		offset += 4
		return f
	end

	local function remaining()
		return size - offset
	end

	local hullRangeCount = readu32()
	local hullRanges = table.create(hullRangeCount)
	for i = 1, hullRangeCount do
		hullRanges[i] = readu32()
	end

	local indexCount = hullRanges[hullRangeCount] or 0
	local indexBase = table.create(indexCount)
	for i = 1, indexCount do
		indexBase[i] = readu32()
	end

	do
		local used = size - remaining()
		local pad = used % 4
		if pad ~= 0 and remaining() >= 4 - pad then
			offset += 4 - pad
		end
	end

	local vertexRanges = {}
	local componentData = {}

	if remaining() > 0 then
		local vertexRangeCount = readu32()
		vertexRanges = table.create(vertexRangeCount)
		for i = 1, vertexRangeCount do
			vertexRanges[i] = readu32()
		end

		local componentCount = vertexRanges[vertexRangeCount] or 0
		if componentCount > 0 then
			componentData = table.create(componentCount)
			for i = 1, componentCount do
				componentData[i] = readf32()
			end
		end
	end

	local hulls = {}
	local idx_start = 0
	local comp_start = 0

	local count = math.min(#hullRanges, #vertexRanges)

	for i = 1, count do
		local idx_end = hullRanges[i]
		local comp_end = vertexRanges[i]

		local verts = {}
		for k = comp_start, comp_end - 1, 3 do
			table.insert(verts, Vector3.new(
				componentData[k+1],
				componentData[k+2],
				componentData[k+3]
				))
		end

		local tris = {}
		for k = idx_start, idx_end - 1, 3 do
			table.insert(tris, {
				indexBase[k+1] + 1,
				indexBase[k+2] + 1,
				indexBase[k+3] + 1
			})
		end

		table.insert(hulls, {
			Vertices = verts,
			Triangles = tris,
			IsRaw = true
		})

		idx_start = idx_end
		comp_start = comp_end
	end

	return hulls
end



return function(collisionData)
	if not collisionData then warn("Collision Data not found") return end;
	local ParsedV8 = ParseV8(collisionData);

	local start = tick();
	local hulls = Edgebreaker.DecodeHulls(ParsedV8.CLERSbuffer, ParsedV8.CLERSbitCount, ParsedV8.HullCount, ParsedV8.Vertices,ParsedV8.TotalFaces)

	for _, hull in hulls do
		hull.IsRaw = false
	end

	local rawHulls = ParseRawHullData(ParsedV8.RawHulls);

	for _, hull in rawHulls do
		--if #hull.Triangles == 0 then continue end;
		table.insert(hulls, hull);
	end


	if DEBUG then warn(`[MESH LAB] Edgebreaker solving time : {tick() - start}`) end;


	return hulls
end]]></ProtectedString>
