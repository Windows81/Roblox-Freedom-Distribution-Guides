						<BinaryString name="Tags"></BinaryString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX61A2043E202B4D738B013B0B6B499DA2">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">MeshFromFile</string>
						<string name="ScriptGuid">{94F299CE-2207-46BE-B62F-7C8B16AE1C49}</string>
						<ProtectedString name="Source"><![CDATA[local StudioService = game:GetService("StudioService");
local AssetService = game:GetService("AssetService");

local module = {
	Icon = "rbxassetid://76115549781375",
	Name = "Editable Mesh from file",
	Category = "Mesh",
	LayoutOrder = 4
}

local camera = workspace.CurrentCamera;

local function createEditableMesh(hull)
	local eMesh: EditableMesh = AssetService:CreateEditableMesh()
	local vertexIds = table.create(#hull.verts)

	for _, vertex in hull.verts do
		local vId = eMesh:AddVertex(vertex)
		table.insert(vertexIds, vId)
	end

	for i, tri in hull.tris do
		if not vertexIds[tri[1]] then
			warn(tri[1],tri[2],tri[3],#hull.verts)
		end
		eMesh:AddTriangle(
			vertexIds[tri[1]],
			vertexIds[tri[2]],
			vertexIds[tri[3]]
		)
	end

	eMesh:RemoveUnused()
	return eMesh
end

local function parseOBJIntoHulls(fileData, separate)
	local lines = fileData:split("\n")

	local allVertices = {}      
	local allFaces = {}      

	local function tonumber_or_nil(s)
		local n = tonumber(s)
		return n
	end

	local function resolveIndex(i, count)
		if i < 0 then
			return count + i + 1
		else
			return i
		end
	end

	local function addFaceIndices(idxs)
		if #idxs < 3 then return end
		for j = 2, #idxs - 1 do
			table.insert(allFaces, { idxs[1], idxs[j], idxs[j+1] })
		end
	end

	for _, line in lines do
		local args = line:split(" ")
		local tag = args[1]

		if tag == "v" then
			local x = tonumber_or_nil(args[2])
			local y = tonumber_or_nil(args[3])
			local z = tonumber_or_nil(args[4])
			if x and y and z then
				table.insert(allVertices, vector.create(x, y, z))
			end

		elseif tag == "f" then
			local raw = {}
			for i = 2, #args do
				local a = args[i]
				if a ~= "" then
					local first = a:split("/")[1]
					local idx = tonumber_or_nil(first)
					if idx then
						idx = resolveIndex(idx, #allVertices)
						table.insert(raw, idx)
					end
				end
			end
			if #raw >= 3 then
				addFaceIndices(raw)
			end
		end
	end

	local nVerts = #allVertices
	local parent = table.create(nVerts)
	local rank = table.create(nVerts)

	for i = 1, nVerts do
		parent[i] = i
		rank[i] = 0
	end

	local function find(a)
		while parent[a] ~= a do
			parent[a] = parent[parent[a]] 
			a = parent[a]
		end
		return a
	end

	local function union(a, b)
		local ra, rb = find(a), find(b)
		if ra == rb then return end
		if rank[ra] < rank[rb] then
			parent[ra] = rb
		elseif rank[ra] > rank[rb] then
			parent[rb] = ra
		else
			parent[rb] = ra
			rank[ra] += 1
		end
	end


	for _, tri in allFaces do
		union(tri[1], tri[2])
		union(tri[2], tri[3])
	end

	local buckets = {allFaces}
	if separate then
		buckets = {}

		for _, tri in allFaces do
			local rep = find(tri[1])
			local list = buckets[rep]
			if list == nil then
				list = {}
				buckets[rep] = list
			end
			table.insert(list, tri)
		end
	end

	
	local function makeHull(facesForHull)
		local used, remap, verts, index = {}, {}, {}, 0

		for _, tri in facesForHull do
			for _, idx in tri do
				used[idx] = true
			end
		end
		for i, v in allVertices do
			if used[i] then
				remap[i] = index
				table.insert(verts, v)
				index += 1
			end
		end

		local tris = {}
		for _, tri in facesForHull do
			table.insert(tris, {
				(remap[tri[1]] or 0) + 1,
				(remap[tri[2]] or 0) + 1,
				(remap[tri[3]] or 0) + 1,
			})
		end

		return { verts = verts, tris = tris }
	end

	local hulls = {}
	for _, facesForHull in buckets do
		table.insert(hulls, makeHull(facesForHull))
	end

	return hulls
end


function module:Run(promptLibrary)	
	local objFile = StudioService:PromptImportFile({"obj"}) :: File;
	if not objFile then return end;
	
	local fileData = objFile:GetBinaryContents();
	
	local cameraCFrame = camera.CFrame;
	local meshPosition = workspace:Raycast(cameraCFrame.Position, cameraCFrame.LookVector * 1000);
	meshPosition = meshPosition and CFrame.new(meshPosition.Position) or cameraCFrame * CFrame.new(0, 0, -1000);
	
	local import;
	
	local prompt = promptLibrary();
	
	local separate = prompt:AddToggle("Separate Loose Meshes", true)
	prompt:AddButton("Import", function()
		import = true;	
	end)
	
	prompt:AddButton("Cancel", function()
		import = false;	
	end)
	
	local promptFrame = prompt.Prompt;

	repeat task.wait() until import ~= nil or not promptFrame.Parent;

	local separateMeshes = separate();
	promptFrame:Destroy();
	
	if not import then return end;
	
	local hulls = parseOBJIntoHulls(fileData, separateMeshes);
	
	local meshCenter, vertCount = Vector3.new(), 0;
	for _, hull in hulls do
		for _, vert in hull.verts do
			meshCenter += vert;
			vertCount += 1
		end
	end
	
	meshCenter /= vertCount;
	
	local meshes = Instance.new("Model");
	meshes.Name = "OBJ";
	meshes.Parent = game:GetService("Selection"):Get()[1] or workspace
	

	for _, hull in hulls do
		local newCenter = Vector3.new()
		for j, vertex in hull.verts do
			newCenter += vertex;
		end
		
		newCenter /= #hull.verts;
		
		for j, vertex in hull.verts do
			hull.verts[j] = vertex - newCenter;
		end

		local editableMesh: EditableMesh = createEditableMesh(hull)
		
		local meshPart: MeshPart = AssetService:CreateMeshPartAsync(Content.fromObject(editableMesh), {CollisionFidelity = Enum.CollisionFidelity.Box})
		meshPart.DoubleSided = true;
		meshPart.Anchored = true
		meshPart.Parent = meshes
		
		meshPart.Position = (meshPosition.Position + newCenter) - meshCenter;
	end

	game:GetService("Selection"):Set({meshes});

end

return module
]]></ProtectedString>
