				</Item>
				<Item class="ModuleScript" referent="RBX0A5898F1395B4F8686443726694C2EE1">
					<Properties>
						<BinaryString name="AttributesSerialize"></BinaryString>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">LoadHulls</string>
						<string name="ScriptGuid">{D05F3D38-D674-41BE-AF1F-7723B6757D4C}</string>
						<ProtectedString name="Source"><![CDATA[local AssetService = game:GetService("AssetService");

local module = {
	Icon = "rbxassetid://124946692047368",
	Name = "Load Editable Collision Geometry",
	LayoutOrder = 2,
	Category = "Collision"
}

local modules = script.Parent.Parent.Modules;

local CollisionData = require(modules.CollisionData);
local rbxmParse = require(modules.rbxmParse);

local COLOR_POOL = {
	Color3.new(1, 0, 0);
	Color3.new(0, 1, 0);
	Color3.new(0, 0, 1);
	Color3.new(1, 1, 0);
	Color3.new(1, 0, 1);
	Color3.new(0, 1, 1);
}


--[==[

LOAD HULLS

Finds collision data
Finds collision version
If new version, warn and stop
if supported version feed to the right parser
if older version, force update to latest version through changing fidelity, then feed to the right parser

PARSER : 

Returns hulls data in this format : 

Hulls = { 
	[HULL1] { 
		Vertices = {
			Vector3.new(?, ?, ?),
			...
		},
		Triangles = {
			{?, ?, ?},
			...
		}
	}
} 


]==]--

function module:Run()
	local obj = game:GetService("Selection"):Get()[1]
	if not (obj:IsA("MeshPart") or obj:IsA("UnionOperation")) then warn('[MESH LAB] Please select a MeshPart') return end

	local latestVersion = 0;
	for _, module in script:GetChildren() do
		local collisionVersion = tonumber(module.Name:sub(7));
		if not collisionVersion then continue end;

		if collisionVersion > latestVersion then
			latestVersion = collisionVersion;
		end
	end

	local parser;

	local function loadCollisionData()
		local rbxmBuffer = game:GetService("SerializationService"):SerializeInstancesAsync({obj})

		local sstrChunk = rbxmParse.GetSSTR(rbxmBuffer, obj);
		local sharedStrings = sstrChunk.SharedStrings;

		local collisionIndex = nil
		for i, s in sharedStrings do
			if s.str:sub(1,6) ~= "CSGPHS" then continue; end
			local collisionVer = buffer.readu32(buffer.fromstring(s.str:sub(7, 11)), 0);

			if collisionVer == 0 then
				warn('[MESH LAB] selected mesh uses Box Collision, please change it to Default, Hull or PreciseConvexDecomposition');
			elseif collisionVer > latestVersion then
				warn(`[MESH LAB] New collision version ({collisionVer}) please inform plugin creators`)
				return
			elseif script:FindFirstChild(`CSGPHS{collisionVer}`) then
				parser = require(script:FindFirstChild(`CSGPHS{collisionVer}`))
			else
				local currentFidelity = obj.CollisionFidelity;
				obj.CollisionFidelity = Enum.CollisionFidelity.Box;
				obj.CollisionFidelity = currentFidelity;
				return loadCollisionData()
			end
			return sharedStrings, i
		end
	end

	local sharedStrings, collisionIndex = loadCollisionData();

	if not collisionIndex then warn('[MESH LAB] Failed to find collision data') return end;

	local collisionData = sharedStrings[collisionIndex].str;

	if not collisionData then warn('[MESH LAB] Failed to find collision data') return end;

	if not parser then warn('[MESH LAB] Failed to fetch parser for collision data') return end;


	local collisionBuffer = buffer.fromstring(collisionData);
	local hulls = parser(collisionBuffer, obj);

	local function createEditableMesh(hull)
		local eMesh: EditableMesh = AssetService:CreateEditableMesh()
		local vertexIds = table.create(#hull.Vertices)

		for _, vertex in hull.Vertices do
			local vId = eMesh:AddVertex(vertex)
			table.insert(vertexIds, vId)
		end

		for i, tri in hull.Triangles do
			if not vertexIds[tri[1]] then
				warn(tri[1],tri[2],tri[3],#hull.Vertices)
			end
			eMesh:AddTriangle(
				vertexIds[tri[1]],
				vertexIds[tri[2]],
				vertexIds[tri[3]]
			)
		end

		eMesh:RemoveUnused()
		return eMesh
	end

	if obj:FindFirstChild("DecomposedMesh") then
		obj.DecomposedMesh:Destroy()
	end
	local decomposedModel = Instance.new("Model")
	decomposedModel.Name = "DecomposedMesh"
	decomposedModel.Parent = obj

	local totalVerts = 0
	local scale = 1

	local meshSize = obj.Size
	local meshScale = obj.MeshSize

	for i, hull in hulls do
		if #hull.Triangles > 0 then
			for j, vertex in hull.Vertices do
				local scaledVertex = (vertex / meshScale) * meshSize;
				local newPos = obj.CFrame:PointToWorldSpace(scaledVertex)
				hull.Vertices[j] = newPos
				totalVerts += 1
			end

			local meshCenter = Vector3.zero
			if #hull.Vertices > 0 then
				local sum = Vector3.zero
				for _, v in hull.Vertices do sum += v end
				meshCenter = sum / #hull.Vertices
			else
				meshCenter = obj.Position
			end

			for j, vertex in hull.Vertices do
				hull.Vertices[j] = vertex - meshCenter;
			end

			local editableMesh: EditableMesh = createEditableMesh(hull)
			local meshPart: MeshPart = AssetService:CreateMeshPartAsync(Content.fromObject(editableMesh), {CollisionFidelity = Enum.CollisionFidelity.Box})

			local rng = Random.new(i)
			meshPart.Color = COLOR_POOL[rng:NextInteger(1, #COLOR_POOL)]
			meshPart.DoubleSided = true;
			meshPart.Position = meshCenter;
			meshPart.Anchored = true
			meshPart.Parent = decomposedModel
			meshPart.Name = i

			if hull.IsRaw then
				meshPart:SetAttribute("IsRaw", true)
			end

			hull.MeshPart = meshPart
		else
			local emptyHull = Instance.new("Folder")
			emptyHull.Name = i
			emptyHull.Parent = decomposedModel

			emptyHull:SetAttribute("IsRaw", true) 
			emptyHull:SetAttribute("ZeroFaces", true)

			hull.MeshPart = emptyHull
		end
	end

	warn(`[MESH LAB] Loaded {#hulls} convex hulls`)
end

return module]]></ProtectedString>
						<int64 name="SourceAssetId">-1</int64>
