						<string name="ScriptGuid">{4ED84774-30B8-45A9-82FF-36FE49F40629}</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--!native
--!optimize 2

local SerializationService = game:GetService("SerializationService")
local AssetService = game:GetService("AssetService")
local Selection = game:GetService("Selection")
local Workspace = game:GetService("Workspace")

local EPS = 1e-6

local DEBUG = false;

type Vertex = Vector3

local module = {
	Icon = "rbxassetid://75490846570565",
	Name = "Convex Hull from selected Meshes",
	LayoutOrder = 7,
	Category = "Mesh"
}

local function dot(a: Vector3, b: Vector3): number
	return a:Dot(b)
end

local function cross(a: Vector3, b: Vector3): Vector3
	return a:Cross(b)
end

function module:Run()
	
	local function computeNormal(a: Vector3, b: Vector3, c: Vector3): Vector3
		local n = cross(b - a, c - a)
		
		if n.Magnitude > 0 then
			return n.Unit
		else
			return Vector3.new(0, 0, 0)
		end
	end

	local function dedupe(points: {Vertex}, tol: number): {Vertex}
		tol = tol or 1e-5
		local seen = {}
		local out = {}
		for _, p in ipairs(points) do
			local kx = math.floor(p.X / tol + 0.5)
			local ky = math.floor(p.Y / tol + 0.5)
			local kz = math.floor(p.Z / tol + 0.5)
			local key = kx .. ":" .. ky .. ":" .. kz
			if not seen[key] then
				seen[key] = true
				table.insert(out, p)
			end
		end
		return out
	end

	local function makeFace(aIdx: number, bIdx: number, cIdx: number, points: {Vertex})
		local a, b, c = points[aIdx], points[bIdx], points[cIdx]
		local n = computeNormal(a, b, c)
		return {
			a = aIdx,
			b = bIdx,
			c = cIdx,
			normal = n,
			outside = {},
			neighbors = {},
		}
	end

	local function faceDistance(face: any, pIdx: number, points: {Vertex}): number
		return dot(points[pIdx] - points[face.a], face.normal)
	end

	local function flipFace(face: any, points: {Vertex})
		face.b, face.c = face.c, face.b
		local a, b, c = points[face.a], points[face.b], points[face.c]
		face.normal = computeNormal(a, b, c)
	end

	local function orientFaceOutward(face: any, interiorVec: Vector3, points: {Vertex})
		if dot(interiorVec - points[face.a], face.normal) > 0 then
			flipFace(face, points)
		end
	end

	local function buildInitialTetra(points: {Vertex})
		assert(#points >= 4, "Need >=4 points")

		local minX_i, maxX_i = 1, 1
		for i = 2, #points do
			if points[i].X < points[minX_i].X then
				minX_i = i
			end
			if points[i].X > points[maxX_i].X then
				maxX_i = i
			end
		end

		local far_i, bestArea = nil, -1
		for i = 1, #points do
			if i ~= minX_i and i ~= maxX_i then
				local area = cross(points[maxX_i] - points[minX_i], points[i] - points[minX_i]).Magnitude
				if area > bestArea then
					bestArea = area
					far_i = i
				end
			end
		end
		assert(far_i, "colinear?")

		local planeN = cross(points[maxX_i] - points[minX_i], points[far_i] - points[minX_i])
		local fourth_i, bestDist = nil, -1
		for i = 1, #points do
			if i ~= minX_i and i ~= maxX_i and i ~= far_i then
				local d = math.abs(dot(planeN.Unit, points[i] - points[minX_i]))
				if d > bestDist then
					bestDist = d
					fourth_i = i
				end
			end
		end
		assert(fourth_i, "coplanar?")

		local used = {}
		used[minX_i] = true
		used[maxX_i] = true
		used[far_i] = true
		used[fourth_i] = true

		local interior = (points[minX_i] + points[maxX_i] + points[far_i] + points[fourth_i]) / 4

		local faces = {}
		table.insert(faces, makeFace(minX_i, maxX_i, far_i, points))
		table.insert(faces, makeFace(minX_i, far_i, fourth_i, points))
		table.insert(faces, makeFace(minX_i, fourth_i, maxX_i, points))
		table.insert(faces, makeFace(maxX_i, fourth_i, far_i, points))

		for _, f in ipairs(faces) do
			orientFaceOutward(f, interior, points)
		end

		return faces, interior, used
	end

	local function edgeKey(u: number, v: number): string
		return tostring(u) .. "|" .. tostring(v)
	end

	local function registerFace(face: any, edgeToFace: {[string]: any})
		for _, e in ipairs({{face.a, face.b}, {face.b, face.c}, {face.c, face.a}}) do
			local k = edgeKey(e[1], e[2])
			edgeToFace[k] = face
			local oppk = edgeKey(e[2], e[1])
			local opp = edgeToFace[oppk]
			if opp then
				face.neighbors[k] = opp
				opp.neighbors[oppk] = face
			end
		end
	end

	local function unregisterFace(face: any, edgeToFace: {[string]: any})
		for _, e in ipairs({{face.a, face.b}, {face.b, face.c}, {face.c, face.a}}) do
			local k = edgeKey(e[1], e[2])
			edgeToFace[k] = nil
			local oppk = edgeKey(e[2], e[1])
			local opp = edgeToFace[oppk]
			if opp and opp.neighbors then
				opp.neighbors[oppk] = nil
			end
		end
	end

	local function assignPoints(pointIndices: {number}, faces: {any}, points: {Vertex})
		for _, f in ipairs(faces) do
			f.outside = {}
		end
		for _, pIdx in ipairs(pointIndices) do
			local bestFace, bestD = nil, EPS
			for _, f in ipairs(faces) do
				local d = faceDistance(f, pIdx, points)
				if d > bestD then
					bestD = d
					bestFace = f
				end
			end
			if bestFace then
				table.insert(bestFace.outside, pIdx)
			end
		end
	end

	local function findVisibleFaces(startFace: any, eyeIdx: number, points: {Vertex})
		local stack = {startFace}
		local visited = {}
		local visible = {}

		while #stack > 0 do
			local f = table.remove(stack)
			if not visited[f] then
				visited[f] = true
				if faceDistance(f, eyeIdx, points) > EPS then
					table.insert(visible, f)

					for _, neighbor in pairs(f.neighbors) do
						if neighbor and not visited[neighbor] then
							table.insert(stack, neighbor)
						end
					end
				end
			end
		end

		local visibleSet = {}
		for _, f in ipairs(visible) do
			visibleSet[f] = true
		end

		return visible, visibleSet
	end

	local function buildHorizon(visibleList: {any}, visibleSet: {[any]: boolean}, edgeToFace: {[string]: any})
		local horizon = {}
		for _, f in ipairs(visibleList) do
			for _, e in ipairs({{f.a, f.b}, {f.b, f.c}, {f.c, f.a}}) do
				local oppKey = edgeKey(e[2], e[1])
				local oppFace = edgeToFace[oppKey]
				if not oppFace or not visibleSet[oppFace] then
					table.insert(horizon, {e[1], e[2]})
				end
			end
		end
		return horizon
	end

	local function quickHull(points: {Vertex}): {any}
		if #points < 4 then
			error("Need at least 4 points")
		end

		local faces, interiorVec, usedMap = buildInitialTetra(points)
		local edgeToFace = {}
		for _, f in ipairs(faces) do
			registerFace(f, edgeToFace)
		end

		local candidates = {}
		for i = 1, #points do
			if not usedMap[i] then
				table.insert(candidates, i)
			end
		end

		assignPoints(candidates, faces, points)

		while true do
			local faceWithOutside = nil
			for _, f in ipairs(faces) do
				if #f.outside > 0 then
					faceWithOutside = f
					break
				end
			end
			if not faceWithOutside then
				break
			end

			local farIdx = faceWithOutside.outside[1]
			local maxD = faceDistance(faceWithOutside, farIdx, points)
			for _, pIdx in ipairs(faceWithOutside.outside) do
				local d = faceDistance(faceWithOutside, pIdx, points)
				if d > maxD then
					maxD = d
					farIdx = pIdx
				end
			end

			local visibleList, visibleSet = findVisibleFaces(faceWithOutside, farIdx, points)

			local reassignMap = {}
			local reassignList = {}
			for _, vf in ipairs(visibleList) do
				for _, pIdx in ipairs(vf.outside) do
					if pIdx ~= farIdx and not reassignMap[pIdx] then
						reassignMap[pIdx] = true
						table.insert(reassignList, pIdx)
					end
				end
			end

			local horizon = buildHorizon(visibleList, visibleSet, edgeToFace)

			for _, vf in ipairs(visibleList) do
				unregisterFace(vf, edgeToFace)
			end
			for i = #faces, 1, -1 do
				if visibleSet[faces[i]] then
					table.remove(faces, i)
				end
			end

			local newFaces = {}
			for _, e in ipairs(horizon) do
				local newF = makeFace(e[1], e[2], farIdx, points)
				orientFaceOutward(newF, interiorVec, points)
				registerFace(newF, edgeToFace)
				table.insert(newFaces, newF)
				table.insert(faces, newF)
			end

			if #reassignList > 0 then
				for _, nf in ipairs(newFaces) do
					nf.outside = {}
				end

				for _, pIdx in ipairs(reassignList) do
					local assigned = false
					local bestFace, bestD = nil, EPS
					for _, nf in ipairs(newFaces) do
						local d = faceDistance(nf, pIdx, points)
						if d > bestD then
							bestD = d
							bestFace = nf
						end
					end
					if bestFace then
						table.insert(bestFace.outside, pIdx)
						assigned = true
					end
				end
			end

			for _, f in ipairs(faces) do
				for i = #f.outside, 1, -1 do
					if f.outside[i] == farIdx then
						table.remove(f.outside, i)
					end
				end
			end
		end

		return faces
	end

	local function collectVertices(meshes: {MeshPart}): {Vertex}
		local allVertices: {Vertex} = {}

		for _, meshPart in ipairs(meshes) do
			local mesh = meshPart.MeshContent.Object :: EditableMesh
			local cframe = meshPart.CFrame

			for _, v in mesh:GetVertices() do
				local localPos = mesh:GetPosition(v)
				local worldPos = cframe:PointToWorldSpace(localPos)

				table.insert(allVertices, worldPos)
			end
		end

		return allVertices
	end

	local function createEditableMeshFromHull(faces: {any}, points: {Vertex}): EditableMesh
		local editableMesh = AssetService:CreateEditableMesh()

		local vertexMap = {}
		local function getVertexID(v: Vertex): number
			local key = tostring(v)
			if not vertexMap[key] then
				vertexMap[key] = editableMesh:AddVertex(v)
			end
			return vertexMap[key]
		end

		for _, face in ipairs(faces) do
			local vid0 = getVertexID(points[face.a])
			local vid1 = getVertexID(points[face.b])
			local vid2 = getVertexID(points[face.c])

			local nid = editableMesh:AddNormal()
			local fid = editableMesh:AddTriangle(vid0, vid1, vid2)

			editableMesh:SetFaceNormals(fid, {nid, nid, nid})
		end

		editableMesh:RemoveUnused()

		return editableMesh
	end

	local selectedModels = Selection:Get()

	if #selectedModels == 0 then
		warn("No models selected!")
		return
	end

	local allVertices = collectVertices(selectedModels)
	local dedupedVertices = dedupe(allVertices, 1e-5)
	
	local start = tick();

	if #dedupedVertices < 4 then
		warn("Not enough distinct points to build a hull")
		return
	end

	local ok, hullFaces = pcall(function()
		return quickHull(dedupedVertices)
	end)

	if not ok then
		warn("QuickHull failed: " .. tostring(hullFaces))
		return
	end
	
	if DEBUG then warn(`[MESH LAB] Quickhull computation time : {tick() - start}`) end

	local mesh = createEditableMeshFromHull(hullFaces, dedupedVertices)

	local meshPart = AssetService:CreateMeshPartAsync(Content.fromObject(mesh),  {CollisionFidelity = Enum.CollisionFidelity.Box})

	meshPart.Material = Enum.Material.Plastic
	meshPart.Transparency = 0
	meshPart.Parent = selectedModels[1].Parent
		
	for _, model in ipairs(selectedModels) do
		if model:IsA("BasePart") then
			model:Destroy()
		end
	end
	
	game:GetService("Selection"):Set({meshPart});
end

return module]]></ProtectedString>
