					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX3523753A532B4979A430F13B2F2EE8CA">
					<Properties>
						<BinaryString name="AttributesSerialize">AQAAAAYAAABIaWRkZW4DAQ==</BinaryString>
						<Content name="LinkedSource"><null></null></Content>
						<string name="Name">OptimizeHullModels</string>
						<string name="ScriptGuid">{AA69D354-0E45-42CD-933C-5FB395A12822}</string>
						<ProtectedString name="Source"><![CDATA[--!strict
--!native
--!optimize 2

local SerializationService = game:GetService("SerializationService")
local AssetService = game:GetService("AssetService")
local Selection = game:GetService("Selection")

local QuickHull = require(script.Parent.Parent.Modules.QuickHull)

local MIN_VERTEX_COUNT = 4
local MIN_VOLUME_RATIO = 0.7

type Vertex = Vector3

local module = {
	Icon = "rbxassetid://75490846570565",
	Name = "Merge Optimized Convex Hulls",
	LayoutOrder = 8,
	Category = "Mesh"
}

function module:Run()
	local function hullVolume(vertices: {Vertex}): number
		if #vertices < 4 then return 0 end
		local minX, maxX = vertices[1].X, vertices[1].X
		local minY, maxY = vertices[1].Y, vertices[1].Y
		local minZ, maxZ = vertices[1].Z, vertices[1].Z
		for _, v in ipairs(vertices) do
			minX = math.min(minX, v.X)
			maxX = math.max(maxX, v.X)
			minY = math.min(minY, v.Y)
			maxY = math.max(maxY, v.Y)
			minZ = math.min(minZ, v.Z)
			maxZ = math.max(maxZ, v.Z)
		end
		return (maxX - minX) * (maxY - minY) * (maxZ - minZ)
	end

	local function collectVertices(meshParts: {MeshPart}): {Vertex}
		local allVertices: {Vertex} = {}
		for _, meshPart in ipairs(meshParts) do
			local mesh = meshPart.MeshContent.Object :: EditableMesh
			local cframe = meshPart.CFrame
			for _, v in mesh:GetVertices() do
				local localPos = mesh:GetPosition(v)
				local worldPos = cframe:PointToWorldSpace(localPos)
				table.insert(allVertices, worldPos)
			end
		end
		return allVertices
	end

	local function createEditableMeshFromHull(faces: {any}, points: {Vertex}): EditableMesh
		local editableMesh = AssetService:CreateEditableMesh()

		local vertexMap = {}
		local function getVertexID(v: Vertex): number
			local key = tostring(v)
			if not vertexMap[key] then
				vertexMap[key] = editableMesh:AddVertex(v)
			end
			return vertexMap[key]
		end

		for _, face in ipairs(faces) do
			local vid0 = getVertexID(points[face.a])
			local vid1 = getVertexID(points[face.b])
			local vid2 = getVertexID(points[face.c])

			local nid = editableMesh:AddNormal()
			local fid = editableMesh:AddTriangle(vid0, vid1, vid2)

			editableMesh:SetFaceNormals(fid, {nid, nid, nid})
		end

		editableMesh:RemoveUnused()
		return editableMesh
	end
	
	local selectedModels = Selection:Get()[1]

	local hullData = {}
	local processed = {}
	local mergedHulls = {}

	for _, meshPart in ipairs(selectedModels:GetChildren()) do
		local vertices = collectVertices({meshPart})
		if #vertices >= MIN_VERTEX_COUNT then
			local points = QuickHull.dedupe(vertices, 1e-5)
			local ok, faces = pcall(function()
				return QuickHull.compute(points)
			end)

			if ok and faces then
				local volume = hullVolume(points)
				hullData[meshPart] = {
					points = points,
					faces = faces,
					volume = volume
				}
			else
				warn("Failed to compute hull for mesh part: " .. meshPart.Name)
			end
		end
	end

	for meshA, dataA in pairs(hullData) do
		if processed[meshA] then
			continue
		end

		local mergeGroup = {meshA}

		local combinedVerts = {}
		for _, v in ipairs(dataA.points) do
			table.insert(combinedVerts, v)
		end

		local combinedVolume = dataA.volume

		for meshB, dataB in pairs(hullData) do
			if meshA == meshB or processed[meshB] then
				continue
			end

			local newVerts = {}
			for _, v in ipairs(combinedVerts) do
				table.insert(newVerts, v)
			end
			for _, v in ipairs(dataB.points) do
				table.insert(newVerts, v)
			end

			local ok, newFaces = pcall(function()
				return QuickHull.compute(newVerts)
			end)

			if not ok then
				continue
			end

			local newVolume = hullVolume(newVerts)
			local volumeRatio = combinedVolume / newVolume

			if volumeRatio >= MIN_VOLUME_RATIO then
				table.insert(mergeGroup, meshB)

				combinedVerts = newVerts
				combinedVolume = newVolume
			end
		end

		for _, m in ipairs(mergeGroup) do
			processed[m] = true
		end

		table.insert(mergedHulls, {
			meshes = mergeGroup,
			verts = combinedVerts,
			volume = combinedVolume
		})
	end

	local originalHullCount = #selectedModels:GetChildren()
	local newHullCount = #mergedHulls

	for _, merged in ipairs(mergedHulls) do
		local ok, faces = pcall(function()
			return QuickHull.compute(merged.verts)
		end)

		if not ok or not faces then
			warn("Failed to compute merged hull")
			continue
		end

		local referenceCFrame = merged.meshes[1].CFrame
		local referencePosition = referenceCFrame.Position

		local localVerts = {}
		for _, vertex in ipairs(merged.verts) do
			table.insert(localVerts, referenceCFrame:PointToObjectSpace(vertex))
		end

		local mesh = createEditableMeshFromHull(faces, localVerts)
		local meshPart = AssetService:CreateMeshPartAsync(Content.fromObject(mesh))

		meshPart.Material = Enum.Material.Plastic
		meshPart.Transparency = 0
		meshPart.Name = "MergedHull_" .. #merged.meshes
		meshPart.CFrame = referenceCFrame
		meshPart.Parent = workspace

		for _, originalMeshPart in ipairs(merged.meshes) do
			if originalMeshPart and originalMeshPart.Parent then
				originalMeshPart:Destroy()
			end
		end

		print("Merged", #merged.meshes, "meshes into a hull with approx volume:", merged.volume)
		print("Number of triangles in merged hull:", #faces)
	end

	print("Original hull count:", originalHullCount)
	print("New merged hull count:", newHullCount)

	if newHullCount == 0 then
		warn("No valid hulls were created from the selection")
	end
end

return module]]></ProtectedString>
