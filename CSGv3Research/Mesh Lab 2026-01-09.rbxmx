						<string name="ScriptGuid">{C201DB18-404F-43AF-A26A-A7B9867B7E39}</string>
						<ProtectedString name="Source"><![CDATA[local Selection = game:GetService("Selection");
local AssetService = game:GetService("AssetService");

local module = {
	Icon = "rbxassetid://128403263703041",
	Name = "View Mesh UVs",
	LayoutOrder = 6,
	Category = "Mesh"
}

local function getTexture(mesh: MeshPart) : Content
	local surfaceAppearance = mesh:FindFirstChildOfClass("SurfaceAppearance");
	if surfaceAppearance then
		return surfaceAppearance.ColorMapContent;
	end
	
	return mesh.TextureContent;
end

function module:Run(promptLibrary)
	local selectedMesh = Selection:Get()[1] :: MeshPart;
	if not (selectedMesh and selectedMesh:IsA'MeshPart') then warn('[MESH LAB] Please select a MeshPart') return end;

	local content = selectedMesh.MeshContent;
	local editableMesh : EditableImage;
	if content.SourceType == Enum.ContentSourceType.Object then
		editableMesh = selectedMesh.MeshContent.Object :: EditableMesh;
	else
		local s = pcall(function() editableMesh = AssetService:CreateEditableMeshAsync(content); end);
		if not s then
			warn('[MESH LAB] You do not have Editable* permission for selected MeshPart');
			return 
		end;
	end;

	local prompt = promptLibrary();
	
	local UVMap = prompt:AddUVMap();
	UVMap.ImageContent = getTexture(selectedMesh);
	
	local UVEditableImage = AssetService:CreateEditableImage({Size = Vector2.one * 1024});
	UVEditableImage:DrawRectangle(Vector2.zero, UVEditableImage.Size, Color3.new(1, 1, 1), 1, Enum.ImageCombineType.Overwrite); -- ALPHA BLEEDING THE WHITE LINES
	
	UVMap.UVs.ImageContent = Content.fromObject(UVEditableImage);
	
	do -- Transparency toggle on hover
		UVMap.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				UVMap.ImageTransparency = 0.5;
			end
		end)
		
		UVMap.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseMovement then
				UVMap.ImageTransparency = 0;
			end
		end)
		
	end
	
	local meshUvs = {};
	local bridges = {};
	
	for _, uvId in editableMesh:GetUVs() do
		local uvCoords = editableMesh:GetUV(uvId);

		meshUvs[uvId] = uvCoords;
	end

	local function bridgeExist(uv1, uv2)
		return	bridges[`{uv1}_{uv2}`] or 
				bridges[`{uv2}_{uv1}`]

	end
	
	local rectanglePrefab = AssetService:CreateEditableImage({Size = Vector2.new(1, 1)});
	rectanglePrefab:DrawRectangle(Vector2.zero, Vector2.one, Color3.new(1, 1, 1), 0, Enum.ImageCombineType.Overwrite);
	
	local function makeBridge(uv1, uv2)
		local scaling = UVEditableImage.Size.X;
		
		local pointA = meshUvs[uv1];
		local pointB = meshUvs[uv2];
		

		local mid = ((pointA + pointB) / 2) * scaling
		local diff = (pointB - pointA) * scaling
		local length = diff.Magnitude
		local angle = math.deg(math.atan2(diff.Y, diff.X))


		UVEditableImage:DrawImageTransformed(mid, Vector2.new(length, 3), angle, rectanglePrefab, {CombineType = Enum.ImageCombineType.Overwrite})
		
		bridges[`{uv1}_{uv2}`] = true;
	end
	
	
	for uvId, _ in meshUvs do
		for _, vertId in editableMesh:GetFacesWithUV(uvId) do
			for _, uvId2 in editableMesh:GetFaceUVs(vertId) do
				if uvId == uvId2 then continue end;
				if bridgeExist(uvId, uvId2) then continue end;

				makeBridge(uvId, uvId2);
			end
		end
	end
	
	
	local promptFrame = prompt.Prompt;
	promptFrame.Size = UDim2.fromOffset(600, 668);

	
	prompt:AddButton("Close", function()
		promptFrame:Destroy();
	end)

end


return module
]]></ProtectedString>
