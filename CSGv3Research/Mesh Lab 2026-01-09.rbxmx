							<Content name="LinkedSource"><null></null></Content>
							<string name="Name">CSGPHS7</string>
							<string name="ScriptGuid">{FA1112EE-BDA3-47EE-AA78-E8CED1B448F2}</string>
							<ProtectedString name="Source"><![CDATA[local DEBUG = false;

type PhysicsData = {
	Volume: number,
	GravityCenter: Vector3,
	
	Im_XX: number, 
	Im_XY: number,
	Im_XZ: number,
	Im_YY: number,
	Im_YZ: number,
	Im_ZZ: number,
}


type Triangle = {
	Idx1: number,
	Idx2: number,
	Idx3: number
}

type Mesh = {
	TRASH_BYTES: nil, -- 40 bytes of nothing
	
	VertCount: number,
	VertWidth: number,
	
	Vertices: {Vector3},
	
	FacesCount: number,
	Triangles: {Triangle}
	
}

type CSGPHS7 = {
	GeomType: number,
	
	PhysData: PhysicsData,
	
	Meshes: {Mesh}
}

return function (collisionBuffer: buffer, mesh: MeshPart)
	local offset = 0;
	local bufferLen = buffer.len(collisionBuffer);
	
	local function readu8()
		local u8 = buffer.readu8(collisionBuffer, offset)
		offset += 1;
		return u8;
	end

	local function readu32()
		local int = buffer.readu32(collisionBuffer, offset);
		offset += 4;
		return int
	end

	local function readf32()
		local float = buffer.readf32(collisionBuffer, offset)
		offset += 4;
		return float;
	end
	
	local function readstr(n)
		local str = buffer.readstring(collisionBuffer, offset, n);
		offset += n;
		return str;
	end

	local function readVector3()
		return vector.create(readf32(), readf32(), readf32())
	end

	local function readPhysicsData() : PhysicsData
		local volume = readf32()
		local gravityCenter = readVector3()
		local im_xx, im_xy, im_xz, im_yy, im_yz, im_zz = readf32(), readf32(), readf32(), readf32(), readf32(), readf32();

		if DEBUG then
			print(`\n-=====[ PHYSICS DATA ]=====-\nVolume: {volume}\nCenter of gravity: {gravityCenter}\n-==========================-\n`)
		end

		return {
			Volume = volume,
			GravityCenter = gravityCenter,
			
			Im_XX = im_xx, 
			Im_XY = im_xy, 
			Im_XZ = im_xz, 
			Im_YY = im_yy, 
			Im_YZ = im_yz, 
			Im_ZZ = im_zz
		}
	end

	local totalFaceCount = 0

	local function readMesh() : Mesh
		offset += 40 -- trash bytes
		local vertexAmount = readu32() / 3;
		local vertices = {};

		local vertWidth = readu32();

		for i = 1, vertexAmount do
			table.insert(vertices, readVector3())
		end

		local faceCount = readu32() / 3;
		local faces = {}

		for i = 1, faceCount do
			table.insert(faces, {readu32() + 1, readu32() + 1, readu32() + 1})
		end

		totalFaceCount += faceCount;

		return {
			VertCount = vertexAmount,
			VertWidth = vertWidth,
			Vertices = vertices,
			
			FacesCount = faceCount,
			Triangles = faces
		};
	end
	

	assert(readstr(6) == "CSGPHS")
	assert(readu32() == 7)
	
	local V7: CSGPHS7 = {} do
		V7.GeomType = readu8();
		
		V7.PhysData = readPhysicsData();
		
		V7.Meshes = {};
		
		while offset + 1 < bufferLen do
			table.insert(V7.Meshes, readMesh())
		end
		
	end

	if DEBUG then
		print(`\n-=====[ COLLISION DATA ]=====-\nHulls: {#V7.Meshes}\nTriangles: {totalFaceCount}\n-============================-\n`)
	end

	return V7.Meshes;
end
]]></ProtectedString>
